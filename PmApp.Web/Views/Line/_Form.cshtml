@model PmApp.Web.Models.ViewModels.LineFormViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger"></div>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code"
               class="form-control"
               placeholder="Contoh: 01" />
        <span asp-validation-for="Code"
              class="text-danger small"></span>
    </div>

    <div class="col-md-8 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name"
               class="form-control"
               placeholder="Contoh: Conrod" />
        <span asp-validation-for="Name"
              class="text-danger small"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="PlantId" class="form-label">
            Plant <span class="text-danger">*</span>
        </label>

        <select asp-for="PlantId"
                asp-items="Model.PlantList"
                class="form-select"
                data-products-url="@Url.Action("GetProducts", "Line")">
            <option value="">-- Pilih Plant --</option>
        </select>

        <span asp-validation-for="PlantId"
              class="text-danger small"></span>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="ProductId" class="form-label">
            Product <span class="text-danger">*</span>
        </label>

        <select asp-for="ProductId"
                asp-items="Model.ProductList"
                class="form-select">
            <option value="">-- Pilih Product --</option>
        </select>

        <span asp-validation-for="ProductId"
              class="text-danger small"></span>
    </div>

    <div class="col-12 mb-3">
        <label asp-for="Description" class="form-label"></label>

        <textarea asp-for="Description"
                  class="form-control"
                  rows="3"
                  placeholder="Deskripsi Line"></textarea>

        <span asp-validation-for="Description"
              class="text-danger small"></span>
    </div>
</div>
