@model PmApp.Web.Models.ViewModels.PasswordIssuedViewModel
@{
    ViewData["Title"] = "Password Sementara";
}
<div class="card border-0 shadow-sm mx-auto" style="max-width:660px;">
    <div class="card-body p-4">
        <h4><i class="bi bi-shield-check text-success"></i> Password sementara dibuat</h4>
        <div class="alert alert-warning"><strong>Catat sekarang.</strong> Password ini hanya ditampilkan pada halaman hasil ini. Jangan mengirimkan melalui kanal publik.</div>
        <p>Pengguna: <strong>@Model.Username</strong></p><p class="text-muted">@Model.Reason</p>
        <label class="form-label">Password sementara</label>
        <div class="input-group">
            <input id="issuedPassword" class="form-control font-monospace" type="password" value="@Model.TemporaryPassword" readonly autocomplete="off" />
            <button type="button" class="btn btn-outline-secondary" id="revealPass">Lihat</button>
            <button type="button" class="btn btn-outline-primary" id="copyPass">Salin</button>
        </div>
        <a asp-action="Index" class="btn btn-primary mt-4">Kembali ke Daftar Pengguna</a>
    </div>
</div>
@section Scripts {
    <script>
        document.getElementById('revealPass').addEventListener('click', () => { const p = document.getElementById('issuedPassword'); p.type = p.type === 'password' ? 'text' : 'password'; });
        document.getElementById('copyPass').addEventListener('click', async () => { const p = document.getElementById('issuedPassword'); try { await navigator.clipboard.writeText(p.value); } catch { p.select(); document.execCommand('copy'); } });
    </script>
}
