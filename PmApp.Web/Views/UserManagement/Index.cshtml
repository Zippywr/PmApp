@model IEnumerable<PmApp.Web.Models.Entities.AppUser>
@using PmApp.Web.Models.Entities
@using System.Linq

@{
    ViewData["Title"] = "Daftar Pengguna";
    string search = ViewBag.Search as string ?? string.Empty;
    string selectedRole = ViewBag.Role as string ?? string.Empty;

    // Siapkan teks nama Product di sini, bukan membuka blok @{ } di dalam @foreach.
    var users = Model.Select(u => new
    {
        Account = u,
        ProductNames = string.Join(", ", u.AssignedProducts.Select(a => a.Product?.Name ?? "-"))
    }).ToList();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h4 class="mb-1"><i class="bi bi-people"></i> Daftar Pengguna</h4>
        <small class="text-muted">Kelola akun, role, dan penugasan Product.</small>
    </div>
    <a asp-controller="UserManagement" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Tambah Pengguna
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form asp-controller="UserManagement" asp-action="Index" method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label for="userSearch" class="form-label">Cari Nama / Username</label>
                <input id="userSearch" name="search" value="@search" class="form-control" placeholder="Cari pengguna..." />
            </div>
            <div class="col-md-3">
                <label for="userRole" class="form-label">Role</label>
                <select id="userRole" name="role" class="form-select searchable-select">
                    <option value="">Semua Role</option>
                    <option value="@AppRoles.Admin" selected="@(selectedRole == AppRoles.Admin)">Admin</option>
                    <option value="@AppRoles.TechnicalSupport" selected="@(selectedRole == AppRoles.TechnicalSupport)">TS</option>
                    <option value="@AppRoles.LineHead" selected="@(selectedRole == AppRoles.LineHead)">Line Head</option>
                    <option value="@AppRoles.Operator" selected="@(selectedRole == AppRoles.Operator)">Operator (Legacy)</option>
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Cari</button>
                <a asp-controller="UserManagement" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Nama / Username</th>
                    <th>Role</th>
                    <th>Product</th>
                    <th>Status</th>
                    <th>Password</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in users)
                {
                    <tr>
                        <td>
                            <strong>@row.Account.FullName</strong>
                            <div class="small text-muted">@row.Account.Username</div>
                        </td>
                        <td>
                            <span class="badge bg-secondary">@(row.Account.Role == AppRoles.LineHead ? "Line Head" : row.Account.Role)</span>
                        </td>
                        <td>
                            @(row.Account.Role == AppRoles.LineHead
                                ? (!string.IsNullOrWhiteSpace(row.ProductNames) ? row.ProductNames : "Belum ditugaskan")
                                : "Semua Product")
                        </td>
                        <td>
                            <span class="badge @(row.Account.IsActive ? "bg-success" : "bg-secondary")">
                                @(row.Account.IsActive ? "Aktif" : "Nonaktif")
                            </span>
                        </td>
                        <td>@(row.Account.MustChangePassword ? "Perlu diganti" : "Normal")</td>
                        <td>
                            <div class="d-flex gap-1 flex-wrap">
                                <a asp-controller="UserManagement" asp-action="Edit" asp-route-id="@row.Account.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <form asp-controller="UserManagement" asp-action="ResetPassword"
                                      asp-route-id="@row.Account.Id" method="post" class="form-confirm"
                                      data-confirm-title="Reset password pengguna?"
                                      data-confirm-message="Sesi pengguna akan dibatalkan dan password sementara baru diberikan."
                                      data-confirm-button="Ya, Reset">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                        <i class="bi bi-key"></i> Reset
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (users.Count == 0)
{
    <div class="alert alert-light border mt-3">Tidak ada pengguna ditemukan.</div>
}
