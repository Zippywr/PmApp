@model PmApp.Web.Models.ViewModels.PartFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="PartNo" class="form-label"></label>
        <input asp-for="PartNo" class="form-control" placeholder="Contoh: 321" />
        <span asp-validation-for="PartNo" class="text-danger small"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Contoh: Bearing 6205" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="Type" class="form-label"></label>
        <input asp-for="Type" class="form-control" placeholder="DGBB" />
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="Unit" class="form-label"></label>
        <input asp-for="Unit" class="form-control" placeholder="PCS" />
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" placeholder="Bearing / Seal / Belt" />
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="BrandId" class="form-label"></label>
        <select asp-for="BrandId" asp-items="Model.BrandList" class="form-select">
            <option value="">-- Pilih Brand --</option>
        </select>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location" class="form-control" placeholder="A-01" />
    </div>

    <div class="col-md-3 mb-3">
        <label asp-for="StockQty" class="form-label"></label>
        <input asp-for="StockQty" type="number" class="form-control" min="0" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="MinQty" class="form-label"></label>
        <input asp-for="MinQty" type="number" class="form-control" min="0" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="MaxQty" class="form-label"></label>
        <input asp-for="MaxQty" type="number" class="form-control" min="0" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="Price" class="form-label"></label>
        <input asp-for="Price" type="number" step="0.01" class="form-control" min="0" />
    </div>

    <div class="col-12 mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
</div>