@{
    ViewData["Title"] = "Import Excel";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-upload"></i> Import Excel Master Data</h4>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    Pilih master data yang mau di-import. Setiap halaman punya
    <strong>template Excel</strong> yang bisa di-download, diisi, lalu di-upload kembali.
</div>

