@{
    ViewData["Title"] = "Import Plant";
    var uploaded = (bool?)ViewBag.Uploaded == true;
    var successCount = (int?)ViewBag.SuccessCount ?? 0;
    var totalRows = (int?)ViewBag.TotalRows ?? 0;
    var errors = ViewBag.Errors as List<string> ?? new List<string>();
    var errorMsg = ViewBag.Error as string;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Import</a></li>
        <li class="breadcrumb-item active">Plant</li>
    </ol>
</nav>

<h4 class="mb-3"><i class="bi bi-building"></i> Import Plant</h4>

@if (!string.IsNullOrEmpty(errorMsg))
{
    <div class="alert alert-danger">
        <i class="bi bi-x-circle"></i> @errorMsg
    </div>
}

@if (uploaded)
{
    <!-- ==================== HASIL IMPORT ==================== -->
    <div class="alert @(successCount > 0 ? "alert-success" : "alert-warning")">
        <h5 class="mb-2">
            <i class="bi bi-check-circle"></i>
            Hasil Import
        </h5>
        <p class="mb-0">
            <strong>@successCount</strong> baris berhasil dari <strong>@totalRows</strong> total baris.
            @if (errors.Any())
            {
                <span class="ms-2"><strong>@errors.Count</strong> baris gagal.</span>
            }
        </p>
    </div>

    @if (errors.Any())
    {
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-danger text-white">
                <i class="bi bi-exclamation-triangle"></i> Detail Error (@errors.Count)
            </div>
            <div class="card-body p-0">
                <ul class="list-group list-group-flush" style="max-height: 300px; overflow-y: auto;">
                    @foreach (var err in errors)
                    {
                        <li class="list-group-item py-2">
                            <i class="bi bi-x-circle text-danger"></i> @err
                        </li>
                    }
                </ul>
            </div>
        </div>
    }

    <a asp-action="Plant" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Import Lagi
    </a>
    <a asp-controller="Plant" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-list"></i> Lihat Daftar Plant
    </a>
}
else
{
    <!-- ==================== FORM UPLOAD ==================== -->
    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <!-- Step 1 -->
            <div class="mb-4">
                <h6 class="text-primary">
                    <span class="badge bg-primary">1</span> Download Template
                </h6>
                <p class="text-muted small mb-2">Download template, lalu isi data di Excel.</p>
                <a asp-action="TemplatePlant" class="btn btn-outline-success">
                    <i class="bi bi-download"></i> Download Template Plant.xlsx
                </a>
            </div>

            <!-- Step 2 -->
            <div class="mb-4">
                <h6 class="text-primary">
                    <span class="badge bg-primary">2</span> Isi Data
                </h6>
                <ul class="text-muted small mb-0">
                    <li>Buka file Excel yang sudah didownload</li>
                    <li>Isi data sesuai kolom yang tersedia</li>
                    <li><strong>Jangan ubah</strong> nama kolom (header)</li>
                    <li>Kode harus unik (tidak boleh duplikat)</li>
                </ul>
            </div>

            <!-- Step 3 -->
            <div class="mb-4">
                <h6 class="text-primary">
                    <span class="badge bg-primary">3</span> Upload File
                </h6>
                <form asp-action="Plant" method="post" enctype="multipart/form-data" class="form-confirm" data-confirm-title="Konfirmasi Import Plant" data-confirm-message="Import Plant dari file Excel ini?" data-confirm-button="Ya, Import" data-loading-text="Mengimport data Excel...">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <input type="file" name="file" class="form-control"
                               accept=".xlsx,.xls" required />
                        <small class="text-muted">Format: .xlsx atau .xls · Max 10 MB</small>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-upload"></i> Proses Import
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Kembali
                    </a>
                </form>
            </div>

        </div>
    </div>
}