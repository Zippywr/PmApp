@model PmApp.Web.Models.ViewModels.PmTaskTemplateFormViewModel
@{
    ViewData["Title"] = "Edit Task PM";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="ListPm">Task PM</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-warning">
        <h5 class="mb-0"><i class="bi bi-pencil"></i> Edit Task PM</h5>
    </div>
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="form-confirm"
              data-confirm-title="Konfirmasi Update"
              data-confirm-message="Yakin update task PM ini?"
              data-confirm-button="Ya, Update">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <div class="mt-3">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-save"></i> Update
                </button>
                <a asp-action="ListPm" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Batal
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/pm-task-select2.js"
            asp-append-version="true"></script>

    <script src="~/js/pm-task-unit-tags.js"
        asp-append-version="true"></script>
}