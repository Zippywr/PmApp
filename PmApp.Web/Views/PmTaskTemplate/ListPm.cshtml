@model IEnumerable<PmApp.Web.Models.ViewModels.PmMachineGroupViewModel>
@{
    ViewData["Title"] = "Daftar Task PM";
    var lines = (List<PmApp.Web.Models.Entities.Line>)ViewBag.Lines;
    var assets = (List<PmApp.Web.Models.Entities.Asset>)ViewBag.Assets;
    var lineId = (int?)ViewBag.LineId;
    var assetId = (int?)ViewBag.AssetId;
    var search = (string?)ViewBag.Search;
    int totalMachines = Model.Count();
    int totalTasks = Model.Sum(g => g.Tasks.Count);
}

@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            showNotify('success', '@Html.Raw(TempData["Success"]?.ToString()?.Replace("'", "\\'"))');
        });
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            showNotify('danger', '@Html.Raw(TempData["Error"]?.ToString()?.Replace("'", "\\'"))');
        });
    </script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">
        <i class="bi bi-list-ul"></i> Daftar Task PM
        <small class="text-muted">
            (@totalMachines mesin, @totalTasks task)
        </small>
    </h4>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> Tambah Task PM
    </a>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label">Line</label>
                <select name="lineId" class="form-select">
                    <option value="">-- Semua Line --</option>
                    @foreach (var l in lines)
                    {
                        if (lineId == l.Id)
                        {
                            <option value="@l.Id" selected>@l.Code - @l.Name</option>
                        }
                        else
                        {
                            <option value="@l.Id">@l.Code - @l.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Mesin</label>
                <select name="assetId" class="form-select">
                    <option value="">-- Semua Mesin --</option>
                    @foreach (var a in assets)
                    {
                        if (assetId == a.Id)
                        {
                            <option value="@a.Id" selected>@a.Code - @a.Name</option>
                        }
                        else
                        {
                            <option value="@a.Id">@a.Code - @a.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Cari</label>
                <input type="text" name="search" class="form-control"
                       placeholder="ID-PM, kode mesin, sub unit..."
                       value="@search" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Filter
                </button>
                <a asp-action="ListPm" class="btn btn-secondary">
                    <i class="bi bi-x-circle"></i> Reset
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        <i class="bi bi-info-circle"></i>
        Belum ada task PM. Silakan tambah dulu di
        <a asp-action="Create">Input PM</a>.
    </div>
}
else
{
    <div class="accordion" id="machineAccordion">
        @{ int idx = 0; }
        @foreach (var group in Model)
        {
            idx++;
            var collapseId = "machine-" + group.Asset.Id;
            var isOpen = Model.Count() == 1;

            <div class="accordion-item mb-2 border-0 shadow-sm">
                <h2 class="accordion-header" id="heading-@group.Asset.Id">
                    <div class="accordion-button @(isOpen ? "" : "collapsed") d-flex flex-wrap align-items-center gap-3"
                         data-bs-toggle="collapse"
                         data-bs-target="#@collapseId"
                         aria-expanded="@(isOpen ? "true" : "false")"
                         role="button"
                         style="cursor: pointer;">

                        <div>
                            <i class="bi bi-gear-fill text-primary"></i>
                            <strong class="ms-1">@group.Asset.Code</strong>
                            <span class="text-muted ms-2">@group.Asset.Name</span>
                        </div>

                        <div class="ms-auto d-flex align-items-center gap-2">

                            @if (group.Asset.Line != null)
                            {
                                <span class="badge bg-info">
                                    <i class="bi bi-diagram-2"></i> @group.Asset.Line.Name
                                </span>
                            }
                            @if (group.Asset.Area != null)
                            {
                                <span class="badge bg-secondary">
                                    <i class="bi bi-grid-3x3-gap"></i> @group.Asset.Area.Name
                                </span>
                            }
                            <span class="badge bg-primary">
                                <i class="bi bi-list-check"></i> @group.Tasks.Count Task
                            </span>

                            <div class="dropdown" onclick="event.stopPropagation();">
                                <button type="button"
                                        class="btn btn-sm btn-success dropdown-toggle"
                                        data-bs-toggle="dropdown"
                                        data-bs-auto-close="true"
                                        aria-expanded="false">
                                    <i class="bi bi-download"></i> Export
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Export" asp-action="MachineExcel"
                                           asp-route-assetId="@group.Asset.Id">
                                            <i class="bi bi-file-earmark-excel text-success"></i> Excel (.xlsx)
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Export" asp-action="MachinePdf"
                                           asp-route-assetId="@group.Asset.Id">
                                            <i class="bi bi-file-earmark-pdf text-danger"></i> PDF
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item"
                                           asp-controller="Export" asp-action="MachineCsv"
                                           asp-route-assetId="@group.Asset.Id">
                                            <i class="bi bi-file-earmark-text text-secondary"></i> CSV
                                        </a>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </h2>

                <div id="@collapseId"
                     class="accordion-collapse collapse @(isOpen ? "show" : "")"
                     data-bs-parent="#machineAccordion">
                    <div class="accordion-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover table-sm mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 90px;">ID-PM</th>
                                        <th>Unit</th>
                                        <th>Sub Unit</th>
                                        <th>Metode</th>
                                        <th>Standar</th>
                                        <th class="text-center" style="width: 60px;">W/H</th>
                                        <th class="text-center" style="width: 50px;">MP</th>
                                        <th class="text-center" style="width: 70px;">Kondisi</th>
                                        <th class="text-center" style="width: 90px;">Periode</th>
                                        <th class="text-center" style="width: 80px;">Mulai</th>
                                        <th class="text-center" style="width: 70px;">Week</th>
                                        <th class="text-center" style="width: 100px;">Aksi</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var task in group.Tasks)
                                    {
                                        <tr>
                                            <td><strong>@task.IdPm</strong></td>
                                            <td>@task.Unit?.Name</td>
                                            <td>@task.SubUnit?.Name</td>
                                            <td>
                                                <span class="badge bg-secondary">@task.Method?.Name</span>
                                            </td>
                                            <td><small>@task.Standard?.Name</small></td>
                                            <td class="text-center">@task.WorkHourMinutes</td>
                                            <td class="text-center">@task.ManPower</td>
                                            <td class="text-center">
                                                @if (task.MachineState == PmApp.Web.Models.MachineRunningState.ON)
                                                {
                                                    <span class="badge bg-success">ON</span>
                                                }
                                                else if (task.MachineState == PmApp.Web.Models.MachineRunningState.OFF)
                                                {
                                                    <span class="badge bg-danger">OFF</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">-</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <span class="badge bg-primary">@task.PeriodeMonth bulan</span>
                                            </td>
                                            <td class="text-center">Bulan @task.StartMonth</td>
                                            <td class="text-center">
                                                @if (task.Week >= 1 && task.Week <= 4)
                                                {
                                                    <span class="badge bg-info">W@(task.Week)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Auto</span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                <a asp-action="Edit" asp-route-id="@task.Id"
                                                   class="btn btn-sm btn-warning" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>

                                                <form asp-action="Delete" asp-route-id="@task.Id"
                                                      method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="button"
                                                            class="btn btn-sm btn-danger btn-delete"
                                                            data-name="Task '@task.IdPm'"
                                                            data-detail="Mesin: @group.Asset.Code"
                                                            title="Hapus">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="mt-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="expandAll()">
            <i class="bi bi-arrows-expand"></i> Buka Semua
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary" onclick="collapseAll()">
            <i class="bi bi-arrows-collapse"></i> Tutup Semua
        </button>
    </div>
}

@section Scripts {
    <script>
        function expandAll() {
            document.querySelectorAll('.accordion-collapse').forEach(el => {
                if (typeof bootstrap !== 'undefined') {
                    let c = bootstrap.Collapse.getInstance(el) || new bootstrap.Collapse(el, { toggle: false });
                    c.show();
                }
            });
        }

        function collapseAll() {
            document.querySelectorAll('.accordion-collapse').forEach(el => {
                if (typeof bootstrap !== 'undefined') {
                    let c = bootstrap.Collapse.getInstance(el) || new bootstrap.Collapse(el, { toggle: false });
                    c.hide();
                }
            });
        }
    </script>
}