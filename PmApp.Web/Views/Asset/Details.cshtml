@model IEnumerable<PmApp.Web.Models.Entities.AssetPart>
@{
    var asset = (PmApp.Web.Models.Entities.Asset)ViewBag.Asset;
    var availableParts = (List<PmApp.Web.Models.Entities.Part>)ViewBag.AvailableParts;
    ViewData["Title"] = "Detail Mesin: " + asset.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Daftar Mesin</a></li>
        <li class="breadcrumb-item active">@asset.Code</li>
    </ol>
</nav>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card mb-4 border-0 shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-gear-fill"></i> @asset.Name</h5>
        <a asp-action="Edit" asp-route-id="@asset.Id" class="btn btn-sm btn-light">
            <i class="bi bi-pencil"></i> Edit
        </a>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-3">
                <small class="text-muted">Kode Mesin</small>
                <p class="mb-0"><strong>@asset.Code</strong></p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">OP No</small>
                <p class="mb-0">@(asset.OpNo ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Line</small>
                <p class="mb-0">@(asset.Line?.Name ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Area</small>
                <p class="mb-0">@(asset.Area?.Name ?? "-")</p>
            </div>

            <div class="col-md-3">
                <small class="text-muted">Kategori Mesin</small>
                <p class="mb-0">@(asset.McCategory?.Name ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Fungsi Mesin</small>
                <p class="mb-0">@(asset.MachineFunction?.Name ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Brand</small>
                <p class="mb-0">@(asset.Brand?.Name ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Product</small>
                <p class="mb-0">@(asset.Product?.Name ?? "-")</p>
            </div>

            <div class="col-md-3">
                <small class="text-muted">Model / Type</small>
                <p class="mb-0">@(asset.Model ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Serial Number</small>
                <p class="mb-0">@(asset.SerialNumber ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Tahun</small>
                <p class="mb-0">@(asset.YearMade?.ToString() ?? "-")</p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Kapasitas</small>
                <p class="mb-0">@(asset.Capacity ?? "-")</p>
            </div>

            <div class="col-md-3">
                <small class="text-muted">Kritikalitas</small>
                <p class="mb-0">
                    @if (asset.Criticality == PmApp.Web.Models.Criticality.Critical)
                    {
                        <span class="badge bg-danger">Critical</span>
                    }
                    else if (asset.Criticality == PmApp.Web.Models.Criticality.High)
                    {
                        <span class="badge bg-warning text-dark">High</span>
                    }
                    else if (asset.Criticality == PmApp.Web.Models.Criticality.Normal)
                    {
                        <span class="badge bg-info text-dark">Normal</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Low</span>
                    }
                </p>
            </div>
            <div class="col-md-3">
                <small class="text-muted">Status</small>
                <p class="mb-0">
                    @if (asset.IsActive)
                    {
                        <span class="badge bg-success">Aktif</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Nonaktif</span>
                    }
                </p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(asset.Description))
        {
            <hr />
            <small class="text-muted">Deskripsi</small>
            <p class="mb-0">@asset.Description</p>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="mb-0">
        <i class="bi bi-list-check"></i> Part Terpasang
        <span class="badge bg-secondary ms-2">@Model.Count() part</span>
    </h5>
    <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addPartModal">
        <i class="bi bi-plus-circle"></i> Tambah Part
    </button>
</div>

@if (!Model.Any())
{
    <div class="alert alert-warning">
        <i class="bi bi-info-circle"></i>
        Belum ada part yang terpasang di mesin ini.
    </div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover table-striped mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="60">No</th>
                        <th>Part No</th>
                        <th>Nama Part</th>
                        <th>Kategori</th>
                        <th>Merek</th>
                        <th width="80" class="text-center">Qty</th>
                        <th>Satuan</th>
                        <th>Posisi</th>
                        <th width="120" class="text-center">Aksi</th>
                    </tr>
                </thead>
                <tbody>
                    @{ int no = 1; }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@no</td>
                            <td>
                                <a asp-controller="Part" asp-action="Details" asp-route-id="@item.PartId">
                                    <strong>@item.Part?.PartNo</strong>
                                </a>
                            </td>
                            <td>@item.Part?.Name</td>
                            <td>@(item.Part?.Category ?? "-")</td>
                            <td>@(item.Part?.Brand?.Name ?? "-")</td>
                            <td class="text-center">
                                <span class="badge bg-primary">@item.Quantity</span>
                            </td>
                            <td>@item.Part?.Unit</td>
                            <td>@item.Position</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-danger"
                                        onclick="confirmRemove(@item.Id, '@item.Part?.Name')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                        no++;
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="addPartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form asp-action="AddPart" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="AssetId" value="@asset.Id" />

                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Tambah Part ke @asset.Name</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Part <span class="text-danger">*</span></label>
                        <select name="PartId" class="form-select" required>
                            <option value="">-- Pilih Part --</option>
                            @foreach (var p in availableParts)
                            {
                                <option value="@p.Id">@p.PartNo - @p.Name (@(p.Category ?? "-"))</option>
                            }
                        </select>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Jumlah <span class="text-danger">*</span></label>
                            <input type="number" name="Quantity" class="form-control" value="1" min="1" required />
                        </div>
                        <div class="col-md-8 mb-3">
                            <label class="form-label">Posisi</label>
                            <input type="text" name="Position" class="form-control" placeholder="Contoh: Spindle Drive End" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Catatan</label>
                        <textarea name="Notes" class="form-control" rows="2"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Simpan</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="removePartModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-trash"></i> Konfirmasi Hapus</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Yakin ingin menghapus part <strong id="removePartName"></strong> dari mesin ini?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Batal</button>
                <form id="removeForm" method="post" asp-action="RemovePart">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="removeId" />
                    <button type="submit" class="btn btn-danger">Ya, Hapus</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmRemove(id, partName) {
            document.getElementById('removeId').value = id;
            document.getElementById('removePartName').textContent = partName;
            new bootstrap.Modal(document.getElementById('removePartModal')).show();
        }
    </script>
}