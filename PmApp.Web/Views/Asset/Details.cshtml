@model IEnumerable<PmApp.Web.Models.Entities.AssetPart>

@{
    var asset = (PmApp.Web.Models.Entities.Asset)ViewBag.Asset;
    var availableParts =
        (List<PmApp.Web.Models.Entities.Part>)ViewBag.AvailableParts;

    ViewData["Title"] = "Detail Machine - " + asset.Code;

    bool isAdmin = User.IsInRole("Admin");

    // Hierarki baru: Plant -> Product -> Line -> Machine
    // Relasi lama tetap digunakan sebagai fallback.
    var line = asset.Line;
    var product = line?.Product ?? asset.Product;
    var plant = line?.Product?.Plant ?? line?.Plant;

    var partCount = Model.Count();
}

<!-- BREADCRUMB -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-action="Index">Daftar Machine</a>
        </li>
        <li class="breadcrumb-item active">
            @asset.Code
        </li>
    </ol>
</nav>

<!-- HEADER -->
<div class="d-flex justify-content-between
    align-items-center mb-4">

    <div>
        <h4 class="mb-1">
            <i class="bi bi-gear-wide-connected me-2"></i>
            @asset.Code
        </h4>

        <div class="text-muted">
            Detail Informasi Machine
        </div>
    </div>

    <div class="d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Kembali
        </a>

        @if (isAdmin)
        {
            <a asp-action="Edit"
               asp-route-id="@asset.Id"
               class="btn btn-warning">
                <i class="bi bi-pencil-square me-1"></i>
                Edit Machine
            </a>
        }
    </div>
</div>

<!-- ==========================================
     INFORMASI UTAMA
========================================== -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white py-3">
        <h6 class="mb-0">
            <i class="bi bi-hdd-rack me-2"></i>
            Informasi Utama Machine
        </h6>
    </div>

    <div class="card-body">
        <div class="row g-4">

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    Code Mesin
                </div>
                <div class="fw-semibold">
                    @asset.Code
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    OP No
                </div>
                <div class="fw-semibold">
                    @(asset.OpNo ?? "-")
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    Plant
                </div>
                <div class="fw-semibold">
                    @(plant?.Name ?? "Belum ditentukan")
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    Product
                </div>
                <div class="fw-semibold">
                    @(product?.Name ?? "Belum ditentukan")
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    Line
                </div>
                <div class="fw-semibold">
                    @(line?.Name ?? "Belum ditentukan")
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    MC Category
                </div>
                <div class="fw-semibold">
                    @(asset.McCategory?.Name ?? "-")
                </div>
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    Status Mesin
                </div>

                @if (asset.IsActive)
                {
                    <span class="badge bg-success">
                        Aktif
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Nonaktif
                    </span>
                }
            </div>

            <div class="col-md-4 col-lg-3">
                <div class="text-muted small mb-1">
                    Kritikalitas
                </div>

                @if (asset.Criticality ==
                    PmApp.Web.Models.Criticality.Critical)
                {
                    <span class="badge bg-danger">
                        Critical
                    </span>
                }
                else if (asset.Criticality ==
                    PmApp.Web.Models.Criticality.High)
                {
                    <span class="badge bg-warning text-dark">
                        High
                    </span>
                }
                else if (asset.Criticality ==
                    PmApp.Web.Models.Criticality.Normal)
                {
                    <span class="badge bg-info text-dark">
                        Normal
                    </span>
                }
                else
                {
                    <span class="badge bg-secondary">
                        Low
                    </span>
                }
            </div>

        </div>
    </div>
</div>

<!-- ==========================================
     INFORMASI TAMBAHAN
========================================== -->
<div class="card border-0 shadow-sm mb-4">

    <div class="card-header bg-white p-0">

        <button type="button"
                class="btn btn-link text-decoration-none
            text-dark w-100 text-start p-3"
                data-bs-toggle="collapse"
                data-bs-target="#additionalInfo"
                aria-expanded="false"
                aria-controls="additionalInfo">

            <i class="bi bi-chevron-down me-2"></i>
            <strong>Informasi Tambahan Machine</strong>

        </button>
    </div>

    <div id="additionalInfo" class="collapse">
        <div class="card-body">
            <div class="row g-4">

                <div class="col-md-4">
                    <div class="text-muted small mb-1">
                        Fungsi Mesin
                    </div>
                    <div>
                        @(asset.MachineFunction?.Name ?? "-")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">
                        Brand / Maker
                    </div>
                    <div>
                        @(asset.Brand?.Name ?? "-")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">
                        Model / Type
                    </div>
                    <div>
                        @(asset.Model ?? "-")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">
                        Serial Number
                    </div>
                    <div>
                        @(asset.SerialNumber ?? "-")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">
                        Tahun Pembuatan
                    </div>
                    <div>
                        @(asset.YearMade?.ToString() ?? "-")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">
                        Kapasitas
                    </div>
                    <div>
                        @(asset.Capacity ?? "-")
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="text-muted small mb-1">
                        Tanggal Instalasi
                    </div>
                    <div>
                        @(asset.InstallDate?.ToString("dd/MM/yyyy")
                            ?? "-")
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(
                    asset.Description))
                {
                    <div class="col-12">
                        <div class="text-muted small mb-1">
                            Deskripsi
                        </div>
                        <div>
                            @asset.Description
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<!-- ==========================================
     BOM / PART TERPASANG
========================================== -->
<div class="d-flex justify-content-between
    align-items-center mb-3">

    <h5 class="mb-0">
        <i class="bi bi-list-check me-2"></i>
        Part Terpasang

        <span class="badge bg-secondary ms-1">
            @partCount Part
        </span>
    </h5>

    @if (isAdmin)
    {
        <button type="button"
                class="btn btn-primary"
                data-bs-toggle="modal"
                data-bs-target="#addPartModal">
            <i class="bi bi-plus-circle me-1"></i>
            Tambah Part
        </button>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">
        <i class="bi bi-info-circle me-2"></i>
        Belum ada part yang terpasang pada mesin ini.
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover
                    align-middle mb-0">

                    <thead class="table-light">
                        <tr>
                            <th>No</th>
                            <th>Part No</th>
                            <th>Nama Part</th>
                            <th>Kategori</th>
                            <th>Merek</th>
                            <th class="text-center">Qty</th>
                            <th>Satuan</th>
                            <th>Posisi</th>

                            @if (isAdmin)
                            {
                                <th class="text-center">
                                    Aksi
                                </th>
                            }
                        </tr>
                    </thead>

                    <tbody>
                        @{
                            int no = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@no</td>

                                <td>
                                    <a asp-controller="Part"
                                       asp-action="Details"
                                       asp-route-id="@item.PartId"
                                       class="fw-semibold
                                        text-decoration-none">
                                        @item.Part?.PartNo
                                    </a>
                                </td>

                                <td>
                                    @item.Part?.Name
                                </td>

                                <td>
                                    @(item.Part?.Category ?? "-")
                                </td>

                                <td>
                                    @(item.Part?.Brand?.Name ?? "-")
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-primary">
                                        @item.Quantity
                                    </span>
                                </td>

                                <td>
                                    @item.Part?.Unit
                                </td>

                                <td>
                                    @(item.Position ?? "-")
                                </td>

                                @if (isAdmin)
                                {
                                    <td class="text-center">

                                        <form asp-action="RemovePart"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@item.Id" />

                                            <button type="submit"
                                                    class="btn btn-sm
                                                btn-danger
                                                btn-delete"
                                                    data-name="@item.Part?.Name"
                                                    data-detail="Hapus part dari mesin @asset.Code?"
                                                    title="Hapus Part">
                                                <i class="bi bi-trash"></i>
                                            </button>

                                        </form>

                                    </td>
                                }
                            </tr>

                            no++;
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>
}

<!-- ==========================================
     MODAL TAMBAH PART - ADMIN ONLY
========================================== -->
@if (isAdmin)
{
    <div class="modal fade"
         id="addPartModal"
         tabindex="-1"
         aria-labelledby="addPartModalTitle"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <form asp-action="AddPart"
                      method="post"
                      class="form-confirm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="AssetId"
                           value="@asset.Id" />

                    <div class="modal-header">
                        <h5 class="modal-title"
                            id="addPartModalTitle">
                            <i class="bi bi-plus-circle me-1"></i>
                            Tambah Part ke @asset.Code
                        </h5>

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="modal"
                                aria-label="Tutup"></button>
                    </div>

                    <div class="modal-body">

                        <div class="mb-3">
                            <label class="form-label">
                                Part
                                <span class="text-danger">*</span>
                            </label>

                            <select name="PartId"
                                    class="form-select"
                                    required>

                                <option value="">
                                    -- Pilih Part --
                                </option>

                                @foreach (var p in availableParts)
                                {
                                    <option value="@p.Id">
                                        @p.PartNo - @p.Name
                                    </option>
                                }

                            </select>
                        </div>

                        <div class="row g-3">

                            <div class="col-md-4">
                                <label class="form-label">
                                    Jumlah
                                </label>

                                <input type="number"
                                       name="Quantity"
                                       class="form-control"
                                       value="1"
                                       min="1"
                                       required />
                            </div>

                            <div class="col-md-8">
                                <label class="form-label">
                                    Posisi
                                </label>

                                <input type="text"
                                       name="Position"
                                       class="form-control"
                                       placeholder="Contoh: Spindle Drive End" />
                            </div>

                        </div>

                        <div class="mt-3">
                            <label class="form-label">
                                Catatan
                            </label>

                            <textarea name="Notes"
                                      class="form-control"
                                      rows="2"></textarea>
                        </div>

                    </div>

                    <div class="modal-footer">

                        <button type="button"
                                class="btn btn-secondary"
                                data-bs-dismiss="modal">
                            Batal
                        </button>

                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>
                            Simpan
                        </button>

                    </div>

                </form>

            </div>
        </div>
    </div>
}
