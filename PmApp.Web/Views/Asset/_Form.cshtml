@model PmApp.Web.Models.ViewModels.AssetFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<!-- ============================================================ -->
<!-- IDENTITAS -->
<!-- ============================================================ -->
<h6 class="text-primary border-bottom pb-2 mb-3">Identitas Mesin</h6>

<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" placeholder="Contoh: 1-MC-01" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-5 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Contoh: CNC Milling 01" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="OpNo" class="form-label"></label>
        <input asp-for="OpNo" class="form-control" placeholder="Contoh: OP-120" />
    </div>
</div>

<!-- ============================================================ -->
<!-- RELASI MASTER -->
<!-- ============================================================ -->
<h6 class="text-primary border-bottom pb-2 mb-3 mt-3">Lokasi & Kategori</h6>

<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="LineId" class="form-label"></label>
        <select asp-for="LineId" asp-items="Model.LineList" class="form-select">
            <option value="">-- Pilih Line --</option>
        </select>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="AreaId" class="form-label"></label>
        <select asp-for="AreaId" asp-items="Model.AreaList" class="form-select">
            <option value="">-- Pilih Area --</option>
        </select>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="McCategoryId" class="form-label"></label>
        <select asp-for="McCategoryId" asp-items="Model.McCategoryList" class="form-select">
            <option value="">-- Pilih Kategori --</option>
        </select>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="MachineFunctionId" class="form-label"></label>
        <select asp-for="MachineFunctionId" asp-items="Model.MachineFunctionList" class="form-select">
            <option value="">-- Pilih Fungsi --</option>
        </select>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="BrandId" class="form-label"></label>
        <select asp-for="BrandId" asp-items="Model.BrandList" class="form-select">
            <option value="">-- Pilih Brand --</option>
        </select>
    </div>

    <div class="col-md-6 mb-3">
        <label asp-for="ProductId" class="form-label"></label>
        <select asp-for="ProductId" asp-items="Model.ProductList" class="form-select">
            <option value="">-- Pilih Product --</option>
        </select>
    </div>
</div>

<!-- ============================================================ -->
<!-- DETAIL TEKNIS -->
<!-- ============================================================ -->
<h6 class="text-primary border-bottom pb-2 mb-3 mt-3">Detail Teknis</h6>

<div class="row">
    <div class="col-md-3 mb-3">
        <label asp-for="Model" class="form-label"></label>
        <input asp-for="Model" class="form-control" placeholder="Contoh: F25M" />
    </div>
    <div class="col-md-3 mb-3">
        <label asp-for="SerialNumber" class="form-label"></label>
        <input asp-for="SerialNumber" class="form-control" placeholder="Contoh: M3975" />
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="YearMade" class="form-label"></label>
        <input asp-for="YearMade" type="number" class="form-control" placeholder="2012" />
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="Capacity" class="form-label"></label>
        <input asp-for="Capacity" class="form-control" placeholder="500x400 mm" />
    </div>
    <div class="col-md-2 mb-3">
        <label asp-for="InstallDate" class="form-label"></label>
        <input asp-for="InstallDate" type="date" class="form-control" />
    </div>

    <div class="col-md-4 mb-3">
        <label asp-for="Criticality" class="form-label"></label>
        <select asp-for="Criticality" class="form-select"
                asp-items="Html.GetEnumSelectList<PmApp.Web.Models.Criticality>()"></select>
    </div>

    <div class="col-md-4 mb-3 d-flex align-items-center">
        <div class="form-check mt-4">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
        </div>
    </div>

    <div class="col-12 mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
    </div>
</div>