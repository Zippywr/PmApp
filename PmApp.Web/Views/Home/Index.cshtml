@model PmApp.Web.Models.ViewModels.HomeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .bg-delay { background-color: #fd7e14 !important; }

    .kanban-col {
        display: flex;
        flex-direction: column;
        height: 100%;
    }

    .kanban-body {
        max-height: 420px;
        overflow-y: auto;
        flex-grow: 1;
    }

    .kanban-card {
        border-left: 3px solid #dee2e6;
        padding: 0.6rem 0.75rem;
        border-bottom: 1px solid #f0f0f0;
        transition: background-color 0.15s;
    }

    .kanban-card:hover {
        background-color: #f8f9fa;
    }

    .kanban-card:last-child {
        border-bottom: none;
    }

    .kanban-card .id-pm {
        font-size: 0.75rem;
        color: #6c757d;
        font-weight: 600;
    }

    .kanban-card .asset-code {
        font-weight: 700;
        font-size: 0.9rem;
    }

    .kanban-card .sub-unit {
        font-size: 0.75rem;
        color: #6c757d;
    }

    /* Week tabs di header kanban Delay */
    .week-tabs {
        display: flex;
        gap: 2px;
        margin-top: 6px;
    }

    .week-tabs a {
        flex: 1;
        text-align: center;
        font-size: 0.7rem;
        font-weight: 700;
        padding: 2px 4px;
        border-radius: 4px;
        text-decoration: none;
        color: #fff;
        background: rgba(255, 255, 255, 0.2);
        transition: background 0.15s;
        position: relative;
    }

    .week-tabs a:hover {
        background: rgba(255, 255, 255, 0.35);
        color: #fff;
    }

    .week-tabs a.active {
        background: #fff;
        color: #dc3545;
    }

    .week-tabs a .cnt {
        font-size: 0.65rem;
        opacity: 0.85;
    }

    .week-tabs a.active .cnt {
        color: #dc3545;
        opacity: 1;
    }

    .tab-badge {
        font-size: 0.8rem;
        padding: 0.25rem 0.6rem;
    }

    .pagination-sm .page-link {
        padding: 0.25rem 0.5rem;
        font-size: 0.8rem;
    }
</style>

<!-- ============================================================ -->
<!-- FILTER BULAN/TAHUN                                            -->
<!-- ============================================================ -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <input type="hidden" name="tab" value="@Model.ActiveTab" />
            <input type="hidden" name="delayWeek" value="@Model.SelectedDelayWeek" />
            <div class="col-md-3">
                <label class="form-label">Bulan (KPI)</label>
                <select name="month" class="form-select">
                    @for (int i = 1; i <= 12; i++)
                    {
                        var name = new DateTime(2026, i, 1).ToString("MMMM");
                        if (Model.SelectedMonth == i)
                        {
                            <option value="@i" selected>@name</option>
                        }
                        else
                        {
                            <option value="@i">@name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Tahun</label>
                <input type="number" name="year" class="form-control"
                       value="@Model.SelectedYear" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Tampilkan
                </button>
                <a asp-action="Index" class="btn btn-secondary">Reset</a>
            </div>
            <div class="col-md-3 text-end">
                <small class="text-muted">Periode KPI</small><br />
                <strong>@Model.MonthName</strong>
            </div>
        </form>
    </div>
</div>

<!-- ============================================================ -->
<!-- KPI CARDS                                                     -->
<!-- ============================================================ -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small opacity-75">Total Mesin</div>
                        <h3 class="mb-0">@Model.TotalAssets</h3>
                    </div>
                    <i class="bi bi-gear" style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="small opacity-75">
                            Total PM Bulan Ini — @Model.MonthName
                        </div>
                        <h3 class="mb-0">@Model.TotalScheduled</h3>
                        <small class="opacity-75">Total task terjadwal</small>
                    </div>
                    <i class="bi bi-calendar-check"
                       style="font-size: 2.5rem; opacity: 0.5;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-info">
            <div class="card-body">
                <div class="small opacity-75">
                    PM Compliance — @Model.MonthName
                </div>
                <h3 class="mb-0">@Model.Compliance%</h3>
                <small class="opacity-75">
                    @Model.TotalOnTime / @Model.TotalScheduled task
                </small>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-warning">
            <div class="card-body">
                <div class="small opacity-75">
                    PM Completion — @Model.MonthName
                </div>
                <h3 class="mb-0">@Model.Completion%</h3>
                <small class="opacity-75">
                    @Model.TotalDone / @Model.TotalScheduled task
                </small>
            </div>
        </div>
    </div>
</div>

<!-- ============================================================ -->
<!-- KANBAN BOARD — 4 KOLOM                                        -->
<!-- ============================================================ -->
<div class="row g-2 mb-3">

    <!-- ============== DELAY (dengan tab minggu) ============== -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 kanban-col">
            <div class="card-header bg-delay text-white py-2">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="small">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <strong>DELAY</strong>
                    </span>
                    <span class="badge bg-light text-dark">@Model.DelayCountTotal</span>
                </div>
                <!-- TAB MINGGU -->
                <div class="week-tabs">
                    @for (int w = 1; w <= 4; w++)
                    {
                        var cnt = Model.DelayCountByWeek.ContainsKey(w) ? Model.DelayCountByWeek[w] : 0;
                        var isWeekActive = Model.SelectedDelayWeek == w;
                        <a asp-action="Index"
                           asp-route-year="@Model.SelectedYear"
                           asp-route-month="@Model.SelectedMonth"
                           asp-route-tab="@Model.ActiveTab"
                           asp-route-activePage="@Model.ActivePage"
                           asp-route-donePage="@Model.DonePage"
                           asp-route-delayWeek="@w"
                           class="@(isWeekActive ? "active" : "")">W@(w) <span class="cnt">(@cnt)</span></a>
                    }
                </div>
            </div>
            <div class="kanban-body">
                @if (!Model.DelayTasks.Any())
                {
                    <div class="p-3 text-center text-muted small">
                        <i class="bi bi-check-circle" style="font-size: 1.8rem;"></i>
                        <p class="mb-0 mt-1">Tidak ada delay di Minggu @Model.SelectedDelayWeek</p>
                    </div>
                }
                else
                {
                    @foreach (var t in Model.DelayTasks)
                    {
                        <div class="kanban-card" style="border-left-color: #dc3545;">
                            <div class="id-pm">@t.IdPm</div>
                            <div class="asset-code">@t.AssetCode</div>
                            <div class="sub-unit">@t.SubUnitName</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <span class="badge bg-danger" style="font-size: 0.7rem;">
                                    @(Math.Abs(t.DaysLeft ?? 0)) hari
                                </span>
                                <a asp-controller="PmSchedule" asp-action="UpdateCell"
                                   asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-warning py-0 px-2">
                                    <i class="bi bi-play-fill"></i>
                                </a>
                            </div>
                        </div>
                    }
                    @if (Model.DelayCountByWeek.GetValueOrDefault(Model.SelectedDelayWeek) > 10)
                    {
                        <div class="text-center py-2">
                            <small class="text-muted">
                                +@(Model.DelayCountByWeek[Model.SelectedDelayWeek] - 10) lagi
                            </small>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- ============== MINGGU INI ============== -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 kanban-col">
            <div class="card-header bg-primary text-white py-2 d-flex justify-content-between align-items-center">
                <span class="small">
                    <i class="bi bi-calendar-week"></i>
                    <strong>MINGGU INI</strong>
                </span>
                <span class="badge bg-light text-primary">@Model.ThisWeekCount</span>
            </div>
            <div class="kanban-body">
                @if (!Model.ThisWeekTasks.Any())
                {
                    <div class="p-3 text-center text-muted small">
                        <i class="bi bi-calendar-check" style="font-size: 1.8rem;"></i>
                        <p class="mb-0 mt-1">Tidak ada</p>
                    </div>
                }
                else
                {
                    @foreach (var t in Model.ThisWeekTasks)
                    {
                        <div class="kanban-card" style="border-left-color: #0d6efd;">
                            <div class="id-pm">@t.IdPm</div>
                            <div class="asset-code">@t.AssetCode</div>
                            <div class="sub-unit">@t.SubUnitName</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <small class="text-muted">@t.PlanDate?.ToString("ddd, dd/MM")</small>
                                <a asp-controller="PmSchedule" asp-action="UpdateCell"
                                   asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-primary py-0 px-2">
                                    <i class="bi bi-play-fill"></i>
                                </a>
                            </div>
                        </div>
                    }
                    @if (Model.ThisWeekCount > 10)
                    {
                        <div class="text-center py-2">
                            <small class="text-muted">+@(Model.ThisWeekCount - 10) lagi</small>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- ============== MINGGU DEPAN ============== -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 kanban-col">
            <div class="card-header bg-info text-white py-2 d-flex justify-content-between align-items-center">
                <span class="small">
                    <i class="bi bi-calendar-plus"></i>
                    <strong>MINGGU DEPAN</strong>
                </span>
                <span class="badge bg-light text-dark">@Model.NextWeekCount</span>
            </div>
            <div class="kanban-body">
                @if (!Model.NextWeekTasks.Any())
                {
                    <div class="p-3 text-center text-muted small">
                        <i class="bi bi-calendar-x" style="font-size: 1.8rem;"></i>
                        <p class="mb-0 mt-1">Tidak ada</p>
                    </div>
                }
                else
                {
                    @foreach (var t in Model.NextWeekTasks)
                    {
                        <div class="kanban-card" style="border-left-color: #0dcaf0;">
                            <div class="id-pm">@t.IdPm</div>
                            <div class="asset-code">@t.AssetCode</div>
                            <div class="sub-unit">@t.SubUnitName</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <small class="text-muted">@t.PlanDate?.ToString("ddd, dd/MM")</small>
                                <a asp-controller="PmSchedule" asp-action="UpdateCell"
                                   asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-info py-0 px-2">
                                    <i class="bi bi-play-fill"></i>
                                </a>
                            </div>
                        </div>
                    }
                    @if (Model.NextWeekCount > 10)
                    {
                        <div class="text-center py-2">
                            <small class="text-muted">+@(Model.NextWeekCount - 10) lagi</small>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

    <!-- ============== SELESAI ============== -->
    <div class="col-12 col-md-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100 kanban-col">
            <div class="card-header bg-success text-white py-2 d-flex justify-content-between align-items-center">
                <span class="small">
                    <i class="bi bi-check-circle-fill"></i>
                    <strong>SELESAI</strong>
                </span>
                <span class="badge bg-light text-success">@Model.CompletedCount</span>
            </div>
            <div class="kanban-body">
                @if (!Model.CompletedKanban.Any())
                {
                    <div class="p-3 text-center text-muted small">
                        <i class="bi bi-inbox" style="font-size: 1.8rem;"></i>
                        <p class="mb-0 mt-1">Belum ada</p>
                    </div>
                }
                else
                {
                    @foreach (var t in Model.CompletedKanban)
                    {
                        <div class="kanban-card" style="border-left-color: #198754;">
                            <div class="id-pm">@t.IdPm</div>
                            <div class="asset-code">@t.AssetCode</div>
                            <div class="sub-unit">@t.SubUnitName</div>
                            <div class="d-flex justify-content-between align-items-center mt-1">
                                <small class="text-success">
                                    <i class="bi bi-check2"></i>
                                    @t.ActualDate?.ToString("dd/MM")
                                </small>
                                <a asp-controller="PmSchedule" asp-action="UpdateCell"
                                   asp-route-id="@t.Id"
                                   class="btn btn-sm btn-outline-secondary py-0 px-2">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </div>
                    }
                    @if (Model.CompletedCount > 10)
                    {
                        <div class="text-center py-2">
                            <small class="text-muted">+@(Model.CompletedCount - 10) lagi</small>
                        </div>
                    }
                }
            </div>
        </div>
    </div>

</div>

<!-- ============================================================ -->
<!-- TAB AKTIF / SELESAI DENGAN PAGINATION                         -->
<!-- ============================================================ -->
<div class="card border-0 shadow-sm mb-3">

    <div class="card-header bg-white p-0">
        <ul class="nav nav-tabs border-0">
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveTab == "active" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.SelectedYear"
                   asp-route-month="@Model.SelectedMonth"
                   asp-route-tab="active"
                   asp-route-activePage="1"
                   asp-route-donePage="@Model.DonePage"
                   asp-route-delayWeek="@Model.SelectedDelayWeek">
                    <i class="bi bi-list-task"></i>
                    <strong>TASK AKTIF</strong>
                    <span class="badge bg-primary tab-badge ms-1">@Model.ActiveTotalItems</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(Model.ActiveTab == "done" ? "active" : "")"
                   asp-action="Index"
                   asp-route-year="@Model.SelectedYear"
                   asp-route-month="@Model.SelectedMonth"
                   asp-route-tab="done"
                   asp-route-activePage="@Model.ActivePage"
                   asp-route-donePage="1"
                   asp-route-delayWeek="@Model.SelectedDelayWeek">
                    <i class="bi bi-check-circle"></i>
                    <strong>TASK SELESAI</strong>
                    <span class="badge bg-success tab-badge ms-1">@Model.DoneTotalItems</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="card-body p-0">

        @{
            var isActive = Model.ActiveTab == "active";
            var rows = isActive ? Model.ActiveTasks : Model.DoneTasks;
            var currentPage = isActive ? Model.ActivePage : Model.DonePage;
            var totalPages = isActive ? Model.ActiveTotalPages : Model.DoneTotalPages;
            var totalItems = isActive ? Model.ActiveTotalItems : Model.DoneTotalItems;
        }

        @if (!rows.Any())
        {
            <div class="p-5 text-center text-muted">
                <i class="bi bi-inbox" style="font-size: 3rem;"></i>
                <p class="mb-0 mt-2">
                    @(isActive ? "Tidak ada task aktif bulan ini" : "Belum ada task selesai bulan ini")
                </p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID-PM</th>
                            <th>Mesin</th>
                            <th>Sub Unit</th>
                            <th>Metode</th>
                            <th>Plan</th>
                            <th>Actual</th>
                            <th>PIC</th>
                            <th>Status</th>
                            <th class="text-center">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in rows)
                        {
                            var statusText = t.Status == "Overdue" ? "Delay" : t.Status;
                            var badge = t.Status switch
                            {
                                "Done" => "bg-success",
                                "Overdue" => "bg-delay",
                                "InProgress" => "bg-primary",
                                "Cancelled" => "bg-secondary",
                                _ => "bg-warning text-dark"
                            };
                            <tr>
                                <td><strong>@t.IdPm</strong></td>
                                <td>
                                    @t.AssetCode
                                    <br />
                                    <small class="text-muted">@t.AssetName</small>
                                </td>
                                <td>@t.SubUnitName</td>
                                <td><span class="badge bg-secondary">@t.MethodName</span></td>
                                <td><small>@t.PlanDate?.ToString("dd/MM/yyyy")</small></td>
                                <td>
                                    <small>
                                        @(t.ActualDate.HasValue
                                            ? t.ActualDate.Value.ToString("dd/MM/yyyy")
                                            : "-")
                                    </small>
                                </td>
                                <td><small>@(t.PIC ?? "-")</small></td>
                                <td><span class="badge @badge">@statusText</span></td>
                                <td class="text-center">
                                    <a asp-controller="PmSchedule" asp-action="UpdateCell"
                                       asp-route-id="@t.Id"
                                       class="btn btn-sm @(isActive ? "btn-warning" : "btn-outline-secondary") py-0 px-2"
                                       title="@(isActive ? "Update" : "Lihat")">
                                        <i class="bi @(isActive ? "bi-pencil" : "bi-eye")"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-2 border-top">
                    <small class="text-muted">
                        Menampilkan
                        <strong>@(((currentPage - 1) * Model.PageSize) + 1)</strong> -
                        <strong>@(Math.Min(currentPage * Model.PageSize, totalItems))</strong>
                        dari <strong>@totalItems</strong> task
                    </small>

                    @{
                        int startPage = Math.Max(1, currentPage - 2);
                        int endPage = Math.Min(totalPages, startPage + 4);
                        if (endPage - startPage < 4) startPage = Math.Max(1, endPage - 4);
                    }

                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-year="@Model.SelectedYear"
                                   asp-route-month="@Model.SelectedMonth"
                                   asp-route-tab="@Model.ActiveTab"
                                   asp-route-activePage="@(isActive ? currentPage - 1 : Model.ActivePage)"
                                   asp-route-donePage="@(isActive ? Model.DonePage : currentPage - 1)"
                                   asp-route-delayWeek="@Model.SelectedDelayWeek">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>

                            @for (int i = startPage; i <= endPage; i++)
                            {
                                <li class="page-item @(i == currentPage ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-year="@Model.SelectedYear"
                                       asp-route-month="@Model.SelectedMonth"
                                       asp-route-tab="@Model.ActiveTab"
                                       asp-route-activePage="@(isActive ? i : Model.ActivePage)"
                                       asp-route-donePage="@(isActive ? Model.DonePage : i)"
                                       asp-route-delayWeek="@Model.SelectedDelayWeek">@i</a>
                                </li>
                            }

                            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-year="@Model.SelectedYear"
                                   asp-route-month="@Model.SelectedMonth"
                                   asp-route-tab="@Model.ActiveTab"
                                   asp-route-activePage="@(isActive ? currentPage + 1 : Model.ActivePage)"
                                   asp-route-donePage="@(isActive ? Model.DonePage : currentPage + 1)"
                                   asp-route-delayWeek="@Model.SelectedDelayWeek">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        }
    </div>
</div>

<!-- ============================================================ -->
<!-- WEEKLY CHART — Bar (Plan/Actual/Delay) + Line (Performance %) -->
<!-- ============================================================ -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <strong>
            <i class="bi bi-graph-up"></i>
            Trend PM per Minggu — @Model.MonthName
        </strong>
        <small class="text-muted">
            <i class="bi bi-info-circle"></i>
            Ganti bulan di filter atas untuk melihat tren bulan lain
        </small>
    </div>
    <div class="card-body" style="height: 360px;">
        @if (Model.Weekly == null || !Model.Weekly.Any())
        {
            <div class="d-flex flex-column justify-content-center align-items-center h-100 text-muted">
                <i class="bi bi-bar-chart" style="font-size: 2rem;"></i>
                <p class="mb-0 mt-2">Belum ada data tren untuk periode ini</p>
            </div>
        }
        else
        {
            <canvas id="weeklyChart"></canvas>
        }
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        const weeklyData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Weekly,
            new System.Text.Json.JsonSerializerOptions
            {
                PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase
            }));

        const canvasEl = document.getElementById('weeklyChart');

        if (canvasEl && weeklyData && weeklyData.length > 0) {

            // ====== Plugin custom: tulis nilai % di atas titik line ======
            const lineLabelPlugin = {
                id: 'lineLabel',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    const meta = chart.getDatasetMeta(3); // dataset index 3 = Performance
                    if (!meta || meta.hidden) return;
                    ctx.save();
                    ctx.font = 'bold 11px sans-serif';
                    ctx.fillStyle = '#b8860b';
                    ctx.textAlign = 'center';
                    meta.data.forEach((pt, i) => {
                        const v = weeklyData[i].performance;
                        if (v > 0) ctx.fillText(`${v}%`, pt.x, pt.y - 10);
                    });
                    ctx.restore();
                }
            };

            new Chart(canvasEl, {
                type: 'bar',
                data: {
                    labels: weeklyData.map(x => x.weekLabel),
                    datasets: [
                        {
                            type: 'bar',
                            label: 'Plan',
                            data: weeklyData.map(x => x.scheduled),
                            backgroundColor: '#0d6efd',
                            borderRadius: 4,
                            order: 3
                        },
                        {
                            type: 'bar',
                            label: 'Actual',
                            data: weeklyData.map(x => x.done),
                            backgroundColor: '#198754',
                            borderRadius: 4,
                            order: 3
                        },
                        {
                            type: 'bar',
                            label: 'Delay',
                            data: weeklyData.map(x => x.delay),
                            backgroundColor: '#fd7e14',
                            borderRadius: 4,
                            order: 3
                        },
                        {
                            type: 'line',
                            label: 'Performance %',
                            data: weeklyData.map(x => x.performance),
                            borderColor: '#ffc107',
                            backgroundColor: 'rgba(255, 193, 7, 0.10)',
                            borderWidth: 3,
                            tension: 0.35,
                            fill: true,
                            pointRadius: 6,
                            pointBackgroundColor: '#ffc107',
                            pointBorderColor: '#fff',
                            pointBorderWidth: 2,
                            yAxisID: 'y1',
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: {
                            position: 'bottom',
                            labels: {
                                usePointStyle: true,
                                boxWidth: 10,
                                padding: 14
                            }
                        },
                        tooltip: {
                            backgroundColor: 'rgba(33, 37, 41, 0.95)',
                            titleColor: '#fff',
                            bodyColor: '#fff',
                            padding: 10,
                            callbacks: {
                                label: function (ctx) {
                                    const v = ctx.parsed.y ?? 0;
                                    if (ctx.dataset.label === 'Performance %') {
                                        return ` ${ctx.dataset.label}: ${v}%`;
                                    }
                                    return ` ${ctx.dataset.label}: ${v}`;
                                },
                                afterBody: function (items) {
                                    const i = items[0].dataIndex;
                                    const w = weeklyData[i];
                                    if (!w || !w.weekStart || !w.weekEnd) return '';
                                    const s = new Date(w.weekStart);
                                    const e = new Date(w.weekEnd);
                                    const fmt = d => String(d.getDate()).padStart(2, '0')
                                        + '/' + String(d.getMonth() + 1).padStart(2, '0');
                                    return `Periode: ${fmt(s)} - ${fmt(e)}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            grid: { display: false }
                        },
                        y: {
                            beginAtZero: true,
                            position: 'left',
                            title: { display: true, text: 'Jumlah Task' },
                            ticks: { stepSize: 1, precision: 0 }
                        },
                        y1: {
                            beginAtZero: true,
                            position: 'right',
                            suggestedMax: 100,
                            title: { display: true, text: 'Performance (%)' },
                            grid: { drawOnChartArea: false },
                            ticks: {
                                callback: v => v + '%',
                                stepSize: 25
                            }
                        }
                    }
                },
                plugins: [lineLabelPlugin]
            });
        }
    </script>
}