@model PmApp.Web.Models.ViewModels.HomeDashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
    bool isActive = Model.ActiveTab == "active";
    var rows = isActive ? Model.ActiveTasks : Model.DoneTasks;
    int currentPage = isActive ? Model.ActivePage : Model.DonePage;
    int totalPages = isActive ? Model.ActiveTotalPages : Model.DoneTotalPages;
    int totalItems = isActive ? Model.ActiveTotalItems : Model.DoneTotalItems;
    bool isLineHead = User.IsInRole("LineHead");
}

