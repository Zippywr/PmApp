@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Total Mesin</div>
                        <h3 class="mb-0">2</h3>
                    </div>
                    <i class="bi bi-gear text-primary" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Total Part</div>
                        <h3 class="mb-0">32</h3>
                    </div>
                    <i class="bi bi-box-seam text-success" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Teknisi</div>
                        <h3 class="mb-0">2</h3>
                    </div>
                    <i class="bi bi-person-badge text-warning" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Jadwal PM</div>
                        <h3 class="mb-0">-</h3>
                    </div>
                    <i class="bi bi-calendar-event text-danger" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info">
    <i class="bi bi-info-circle"></i>
    <strong>Fase A selesai.</strong> Data master sudah siap. Selanjutnya: kelola Mesin, Part, dan Teknisi lewat menu di samping.
</div>