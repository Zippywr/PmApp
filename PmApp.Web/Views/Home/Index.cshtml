    <div class="dash-heading">
        <div>
            <h1 class="dash-title">Dashboard Maintenance</h1>
            <p class="dash-subtitle mb-0">Ringkasan pekerjaan · @Model.MonthName</p>
        </div>
        <a asp-controller="PmSchedule" asp-action="ByMonth"
           asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
           asp-route-productId="@Model.SelectedProductId"
           class="btn btn-primary px-3" style="min-height:42px;border-radius:9px;">
            <i class="bi bi-clipboard-check me-1" aria-hidden="true"></i> Pelaksanaan PM
        </a>
    </div>

    <!-- Filter sama periode dengan halaman Pelaksanaan PM. -->
    <section class="dash-panel dash-filter" aria-label="Filter dashboard">
        <form asp-controller="Home" asp-action="Index" method="get" class="row g-2 align-items-end">
            <input type="hidden" name="tab" value="@Model.ActiveTab" />
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label" for="dashMonth">Bulan</label>
                <select name="month" id="dashMonth" class="form-select">
                    @for (int i = 1; i <= 12; i++)
                    {
                        var name = new DateTime(Model.SelectedYear, i, 1).ToString("MMMM", new System.Globalization.CultureInfo("id-ID"));
                        <option value="@i" selected="@(Model.SelectedMonth == i)">@name</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3 col-xl-2">
                <label class="form-label" for="dashYear">Tahun</label>
                <input type="number" name="year" id="dashYear" min="2000" max="2100"
                       class="form-control" value="@Model.SelectedYear" required />
            </div>
            <div class="col-12 col-md-6 col-xl-4">
                <label class="form-label" for="dashProduct">Product</label>
                <select name="productId" id="dashProduct" class="form-select">
                    <option value="">Semua Product yang diizinkan</option>
                    @foreach (var product in Model.ProductOptions)
                    {
                        <option value="@product.Id" selected="@(Model.SelectedProductId == product.Id)">@product.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-xl-4 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1" aria-hidden="true"></i> Terapkan</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Reset</a>
            </div>
        </form>
    </section>

    <!-- KPI: sesuai status langsung Done, tanpa antrean approval. -->
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-6 col-xl-3">
            <div class="dash-panel dash-kpi kpi-total h-100">
                <div class="d-flex justify-content-between align-items-start gap-1">
                    <span class="dash-label">Total Task PM</span>
                    <span class="dash-icon"><i class="bi bi-calendar3" aria-hidden="true"></i></span>
                </div>
                <div class="dash-value">@Model.TotalScheduled</div>
                <div class="dash-detail">@Model.TotalAssets mesin terpantau</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="dash-panel dash-kpi kpi-done h-100">
                <div class="d-flex justify-content-between align-items-start gap-1">
                    <span class="dash-label">Selesai (Done)</span>
                    <span class="dash-icon"><i class="bi bi-check2-circle" aria-hidden="true"></i></span>
                </div>
                <div class="dash-value">@Model.TotalDone</div>
                <div class="dash-detail">Langsung Done setelah disimpan</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="dash-panel dash-kpi kpi-pending h-100">
                <div class="d-flex justify-content-between align-items-start gap-1">
                    <span class="dash-label">Pending</span>
                    <span class="dash-icon"><i class="bi bi-hourglass-split" aria-hidden="true"></i></span>
                </div>
                <div class="dash-value">@Model.TotalPending</div>
                <div class="dash-detail">Belum selesai, belum terlambat</div>
            </div>
        </div>
        <div class="col-6 col-xl-3">
            <div class="dash-panel dash-kpi kpi-delay h-100">
                <div class="d-flex justify-content-between align-items-start gap-1">
                    <span class="dash-label">Delay</span>
                    <span class="dash-icon"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></span>
                </div>
                <div class="dash-value">@Model.DelayCountTotal</div>
                <div class="dash-detail">Melewati Plan, belum Done</div>
            </div>
        </div>
    </div>

    <section class="dash-panel dash-progress" aria-label="Progres PM">
        <div class="d-flex justify-content-between align-items-center gap-2 mb-2">
            <span class="dash-progress-label">Penyelesaian PM bulan ini</span>
            <strong class="text-success" style="font-size:1.05rem">@Model.Completion.ToString("0.#")%</strong>
        </div>
        <div class="dash-progress-track" role="progressbar" aria-valuenow="@Model.Completion"
             aria-valuemin="0" aria-valuemax="100" aria-label="Persentase penyelesaian PM">
            <div class="dash-progress-bar" style="width:@(Model.Completion.ToString(System.Globalization.CultureInfo.InvariantCulture))%"></div>
        </div>
        <div class="d-flex justify-content-between flex-wrap gap-1 mt-2 dash-progress-extra">
            <span>@Model.TotalDone dari @Model.TotalScheduled task selesai</span>
            <span>@Model.TotalOnTime tepat pada minggu rencana (@Model.Compliance.ToString("0.#")%)</span>
        </div>
    </section>

    <div class="dash-section-head">
        <h2 class="dash-section-title">Pemantauan Pekerjaan</h2>
        <span class="dash-section-note">Menampilkan task dari periode yang dipilih</span>
    </div>
    <div class="row g-2 g-md-3 mb-3">
        <div class="col-12 col-md-6 col-xl-3">
            <section class="dash-panel dash-board delay" aria-label="Daftar PM terlambat">
                <div class="dash-board-header"><strong><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> Delay</strong><span class="dash-board-count">@Model.DelayCountTotal</span></div>
                <div class="dash-week-tabs" aria-label="Pilih minggu untuk delay">
                    @for (int w = 1; w <= 4; w++)
                    {
                        int count = Model.DelayCountByWeek.GetValueOrDefault(w);
                        <a asp-controller="Home" asp-action="Index"
                           asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                           asp-route-productId="@Model.SelectedProductId" asp-route-tab="@Model.ActiveTab"
                           asp-route-activePage="@Model.ActivePage" asp-route-donePage="@Model.DonePage"
                           asp-route-delayWeek="@w" class="@(Model.SelectedDelayWeek == w ? "active" : "")"
                           aria-label="Delay minggu @w: @count task">W@(w) (@count)</a>
                    }
                </div>
                <div class="dash-board-items">
                    @if (Model.DelayTasks.Count == 0)
                    {
                        <div class="dash-empty"><i class="bi bi-check-circle" aria-hidden="true"></i>Tidak ada delay di W@Model.SelectedDelayWeek</div>
                    }
                    else
                    {
                        @foreach (var t in Model.DelayTasks)
                        {
                            <div class="dash-task">
                                <div class="dash-task-id-label">ID-PM</div>
                                <div class="dash-task-id">@t.IdPm</div>
                                <div class="dash-task-machine"><i class="bi bi-gear me-1" aria-hidden="true"></i>Mesin: @t.AssetCode</div>
                                <div class="dash-task-unit">@t.SubUnitName</div>
                                <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                    <span class="dash-status delay">Lewat @Math.Abs(t.DaysLeft ?? 0) hari</span>
                                    <a asp-controller="PmSchedule" asp-action="UpdateCell" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-warning" aria-label="Isi PM @t.IdPm">Isi PM</a>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.DelayCountByWeek.GetValueOrDefault(Model.SelectedDelayWeek) > Model.DelayTasks.Count)
                {
                    <a class="dash-more" asp-controller="PmSchedule" asp-action="ByMonth"
                       asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                       asp-route-productId="@Model.SelectedProductId" asp-route-status="delay">Lihat semua Delay <i class="bi bi-arrow-right"></i></a>
                }
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <section class="dash-panel dash-board current" aria-label="Task minggu ini">
                <div class="dash-board-header"><strong><i class="bi bi-calendar-week" aria-hidden="true"></i> Minggu Ini</strong><span class="dash-board-count">@Model.ThisWeekCount</span></div>
                <div class="dash-board-items">
                    @if (Model.ThisWeekTasks.Count == 0)
                    {
                        <div class="dash-empty"><i class="bi bi-calendar-check" aria-hidden="true"></i>Tidak ada task mendatang minggu ini</div>
                    }
                    else
                    {
                        @foreach (var t in Model.ThisWeekTasks)
                        {
                            <div class="dash-task">
                                <div class="dash-task-id-label">ID-PM</div>
                                <div class="dash-task-id">@t.IdPm</div>
                                <div class="dash-task-machine"><i class="bi bi-gear me-1" aria-hidden="true"></i>Mesin: @t.AssetCode</div>
                                <div class="dash-task-unit">@t.SubUnitName</div>
                                <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                    <span class="dash-task-date"><i class="bi bi-calendar me-1"></i>@(t.PlanDate?.ToString("dd/MM/yyyy") ?? "-")</span>
                                    <a asp-controller="PmSchedule" asp-action="UpdateCell" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-primary" aria-label="Isi PM @t.IdPm">Isi PM</a>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.ThisWeekCount > Model.ThisWeekTasks.Count)
                {
                    <a class="dash-more" asp-controller="PmSchedule" asp-action="ByMonth"
                       asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                       asp-route-productId="@Model.SelectedProductId">Lihat semua task <i class="bi bi-arrow-right"></i></a>
                }
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <section class="dash-panel dash-board next" aria-label="Task minggu depan">
                <div class="dash-board-header"><strong><i class="bi bi-calendar-plus" aria-hidden="true"></i> Minggu Depan</strong><span class="dash-board-count">@Model.NextWeekCount</span></div>
                <div class="dash-board-items">
                    @if (Model.NextWeekTasks.Count == 0)
                    {
                        <div class="dash-empty"><i class="bi bi-calendar2" aria-hidden="true"></i>Tidak ada task minggu depan</div>
                    }
                    else
                    {
                        @foreach (var t in Model.NextWeekTasks)
                        {
                            <div class="dash-task">
                                <div class="dash-task-id-label">ID-PM</div>
                                <div class="dash-task-id">@t.IdPm</div>
                                <div class="dash-task-machine"><i class="bi bi-gear me-1" aria-hidden="true"></i>Mesin: @t.AssetCode</div>
                                <div class="dash-task-unit">@t.SubUnitName</div>
                                <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                    <span class="dash-task-date"><i class="bi bi-calendar me-1"></i>@(t.PlanDate?.ToString("dd/MM/yyyy") ?? "-")</span>
                                    <a asp-controller="PmSchedule" asp-action="UpdateCell" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-primary" aria-label="Isi PM @t.IdPm">Isi PM</a>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.NextWeekCount > Model.NextWeekTasks.Count)
                {
                    <a class="dash-more" asp-controller="PmSchedule" asp-action="ByMonth"
                       asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                       asp-route-productId="@Model.SelectedProductId">Lihat semua task <i class="bi bi-arrow-right"></i></a>
                }
            </section>
        </div>
        <div class="col-12 col-md-6 col-xl-3">
            <section class="dash-panel dash-board done" aria-label="PM selesai">
                <div class="dash-board-header"><strong><i class="bi bi-check-circle" aria-hidden="true"></i> Selesai</strong><span class="dash-board-count">@Model.CompletedCount</span></div>
                <div class="dash-board-items">
                    @if (Model.CompletedKanban.Count == 0)
                    {
                        <div class="dash-empty"><i class="bi bi-inbox" aria-hidden="true"></i>Belum ada PM selesai</div>
                    }
                    else
                    {
                        @foreach (var t in Model.CompletedKanban)
                        {
                            <div class="dash-task">
                                <div class="dash-task-id-label">ID-PM</div>
                                <div class="dash-task-id">@t.IdPm</div>
                                <div class="dash-task-machine"><i class="bi bi-gear me-1" aria-hidden="true"></i>Mesin: @t.AssetCode</div>
                                <div class="dash-task-unit">@t.SubUnitName</div>
                                <div class="d-flex justify-content-between align-items-center gap-2 mt-2">
                                    <span class="dash-task-date text-success"><i class="bi bi-check-circle me-1"></i>@(t.ActualDate?.ToString("dd/MM/yyyy") ?? "-")</span>
                                    <a asp-controller="PmSchedule" asp-action="UpdateCell" asp-route-id="@t.Id"
                                       class="btn btn-sm btn-outline-success" aria-label="@(isLineHead ? "Lihat" : "Lihat atau koreksi") PM @t.IdPm">@(isLineHead ? "Lihat" : "Koreksi")</a>
                                </div>
                            </div>
                        }
                    }
                </div>
                @if (Model.CompletedCount > Model.CompletedKanban.Count)
                {
                    <a class="dash-more" asp-controller="PmSchedule" asp-action="ByMonth"
                       asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                       asp-route-productId="@Model.SelectedProductId" asp-route-status="done">Lihat semua Done <i class="bi bi-arrow-right"></i></a>
                }
            </section>
        </div>
    </div>

    <section class="dash-panel mb-3" aria-label="Daftar task PM">
        <div class="dash-tabs" role="tablist" aria-label="Status pekerjaan">
            <a role="tab" aria-selected="@(isActive ? "true" : "false")"
               asp-controller="Home" asp-action="Index" asp-route-tab="active"
               asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
               asp-route-productId="@Model.SelectedProductId" asp-route-delayWeek="@Model.SelectedDelayWeek"
               class="nav-link @(isActive ? "active" : "")">
                <i class="bi bi-list-task" aria-hidden="true"></i> Aktif <span class="badge text-bg-primary">@Model.ActiveTotalItems</span>
            </a>
            <a role="tab" aria-selected="@(!isActive ? "true" : "false")"
               asp-controller="Home" asp-action="Index" asp-route-tab="done"
               asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
               asp-route-productId="@Model.SelectedProductId" asp-route-delayWeek="@Model.SelectedDelayWeek"
               class="nav-link @(!isActive ? "active" : "")">
                <i class="bi bi-check2-circle" aria-hidden="true"></i> Done <span class="badge text-bg-success">@Model.DoneTotalItems</span>
            </a>
        </div>
        @if (rows.Count == 0)
        {
            <div class="dash-empty" style="min-height:180px"><i class="bi bi-inbox" aria-hidden="true"></i>@(isActive ? "Tidak ada task aktif pada periode ini" : "Belum ada PM Done pada periode ini")</div>
        }
        else
        {
            <!-- Desktop: tabel. Mobile/tablet: daftar kartu tanpa scroll horizontal. -->
            <div class="table-responsive d-none d-xl-block">
                <table class="table table-hover dash-table">
                    <thead><tr><th>ID-PM</th><th>Mesin</th><th>Sub Unit</th><th>Metode</th><th>Plan</th><th>Actual</th><th>PIC</th><th>Status</th><th>Aksi</th></tr></thead>
                    <tbody>
                        @foreach (var t in rows)
                        {
                            string status = t.Status == "Done" ? "Done" : t.IsDelayed ? "Delay" : t.Status == "InProgress" ? "On Progress" : "Scheduled";
                            string statusClass = t.Status == "Done" ? "done" : t.IsDelayed ? "delay" : t.Status == "InProgress" ? "progressing" : "pending";
                            <tr>
                                <td><span class="dash-table-pm-id">@t.IdPm</span></td>
                                <td><span class="dash-table-machine">@t.AssetCode</span><div class="text-muted small">@t.AssetName</div></td>
                                <td>@t.SubUnitName</td>
                                <td>@t.MethodName</td>
                                <td class="text-nowrap">@(t.PlanDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td class="text-nowrap">@(t.ActualDate?.ToString("dd/MM/yyyy") ?? "-")</td>
                                <td>@(string.IsNullOrWhiteSpace(t.PIC) ? "-" : t.PIC)</td>
                                <td><span class="dash-status @statusClass">@status</span></td>
                                <td>
                                    <a asp-controller="PmSchedule" asp-action="UpdateCell" asp-route-id="@t.Id"
                                       class="btn btn-sm @(t.Status == "Done" ? "btn-outline-secondary" : "btn-outline-primary")">@(t.Status == "Done" ? (isLineHead ? "Lihat" : "Koreksi") : "Isi PM")</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-xl-none">
                @foreach (var t in rows)
                {
                    string status = t.Status == "Done" ? "Done" : t.IsDelayed ? "Delay" : t.Status == "InProgress" ? "On Progress" : "Scheduled";
                    string statusClass = t.Status == "Done" ? "done" : t.IsDelayed ? "delay" : t.Status == "InProgress" ? "progressing" : "pending";
                    <article class="dash-mobile-item">
                        <div class="d-flex justify-content-between gap-2 align-items-start mb-2">
                            <div class="dash-mobile-primary">
                                <div class="dash-task-id-label">ID-PM</div>
                                <div class="dash-mobile-pm-id">@t.IdPm</div>
                                <div class="dash-mobile-machine"><i class="bi bi-gear me-1" aria-hidden="true"></i>Mesin: @t.AssetCode</div>
                                <div class="dash-mobile-label">@t.AssetName</div>
                            </div>
                            <span class="dash-status @statusClass">@status</span>
                        </div>
                        <div class="row g-2 mb-3">
                            <div class="col-6"><div class="dash-mobile-label">Sub Unit</div><div class="dash-mobile-value">@t.SubUnitName</div></div>
                            <div class="col-6"><div class="dash-mobile-label">Metode</div><div class="dash-mobile-value">@t.MethodName</div></div>
                            <div class="col-6"><div class="dash-mobile-label">Plan</div><div class="dash-mobile-value">@(t.PlanDate?.ToString("dd/MM/yyyy") ?? "-")</div></div>
                            <div class="col-6"><div class="dash-mobile-label">Actual</div><div class="dash-mobile-value">@(t.ActualDate?.ToString("dd/MM/yyyy") ?? "-")</div></div>
                            <div class="col-12"><div class="dash-mobile-label">PIC</div><div class="dash-mobile-value">@(string.IsNullOrWhiteSpace(t.PIC) ? "-" : t.PIC)</div></div>
                        </div>
                        <a asp-controller="PmSchedule" asp-action="UpdateCell" asp-route-id="@t.Id"
                           class="btn btn-sm w-100 @(t.Status == "Done" ? "btn-outline-secondary" : "btn-primary")">@(t.Status == "Done" ? (isLineHead ? "Lihat Detail" : "Lihat / Koreksi") : "Isi PM")</a>
                    </article>
                }
            </div>
        }
        <div class="dash-pagination">
            <span class="dash-section-note">@totalItems task · Halaman @currentPage dari @totalPages</span>
            <div class="d-flex gap-2">
                @if (currentPage > 1)
                {
                    <a class="btn btn-outline-secondary btn-sm" asp-controller="Home" asp-action="Index"
                       asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                       asp-route-productId="@Model.SelectedProductId" asp-route-tab="@Model.ActiveTab"
                       asp-route-delayWeek="@Model.SelectedDelayWeek"
                       asp-route-activePage="@(isActive ? currentPage - 1 : Model.ActivePage)"
                       asp-route-donePage="@(isActive ? Model.DonePage : currentPage - 1)"><i class="bi bi-chevron-left me-1"></i> Sebelumnya</a>
                }
                @if (currentPage < totalPages)
                {
                    <a class="btn btn-outline-primary btn-sm" asp-controller="Home" asp-action="Index"
                       asp-route-year="@Model.SelectedYear" asp-route-month="@Model.SelectedMonth"
                       asp-route-productId="@Model.SelectedProductId" asp-route-tab="@Model.ActiveTab"
                       asp-route-delayWeek="@Model.SelectedDelayWeek"
                       asp-route-activePage="@(isActive ? currentPage + 1 : Model.ActivePage)"
                       asp-route-donePage="@(isActive ? Model.DonePage : currentPage + 1)">Berikutnya <i class="bi bi-chevron-right ms-1"></i></a>
                }
            </div>
        </div>
    </section>

    <section class="dash-panel mb-3" aria-label="Grafik hasil PM per minggu">
        <div class="dash-chart-header">
            <h2 class="dash-section-title mb-0"><i class="bi bi-bar-chart-line me-2 text-primary" aria-hidden="true"></i>Rekap PM per Minggu</h2>
            <span class="dash-section-note">W1: 1–7 · W2: 8–14 · W3: 15–21 · W4: 22–akhir bulan</span>
        </div>
        @if (Model.TotalScheduled == 0)
        {
            <div class="dash-empty" style="min-height:190px"><i class="bi bi-bar-chart" aria-hidden="true"></i>Belum ada jadwal PM pada periode ini</div>
        }
        else
        {
            <div class="dash-chart"><canvas id="dashWeeklyChart" role="img" aria-label="Grafik Plan, Actual Done, Delay, dan tingkat penyelesaian per minggu"></canvas></div>
        }
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const chartCanvas = document.getElementById('dashWeeklyChart');
            if (!chartCanvas || typeof Chart === 'undefined') return;
            const weeks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Weekly,
                            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));
            const isSmall = window.matchMedia('(max-width: 575px)').matches;
            new Chart(chartCanvas, {
                type: 'bar',
                data: {
                    labels: weeks.map(x => x.weekLabel),
                    datasets: [
                        { label: 'Plan', data: weeks.map(x => x.scheduled), backgroundColor: '#2563eb', borderRadius: 4, order: 2 },
                        { label: 'Done', data: weeks.map(x => x.done), backgroundColor: '#16a34a', borderRadius: 4, order: 2 },
                        { label: 'Delay', data: weeks.map(x => x.delay), backgroundColor: '#d97706', borderRadius: 4, order: 2 },
                        {
                            type: 'line', label: 'Completion (%)', data: weeks.map(x => x.performance),
                            borderColor: '#0f5778', backgroundColor: '#0f5778', borderWidth: 2,
                            pointRadius: 4, tension: .25, yAxisID: 'percent', order: 1
                        }
                    ]
                },
                options: {
                    responsive: true, maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, font: { size: isSmall ? 10 : 12 } } },
                        tooltip: {
                            callbacks: {
                                afterBody: items => {
                                    if (!items.length) return '';
                                    const w = weeks[items[0].dataIndex];
                                    if (!w) return '';
                                    const date = x => new Date(x).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit' });
                                    return `${date(w.weekStart)} - ${date(w.weekEnd)}`;
                                }
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false } },
                        y: { beginAtZero: true, ticks: { precision: 0, stepSize: 1 }, title: { display: !isSmall, text: 'Jumlah task' } },
                        percent: {
                            beginAtZero: true, position: 'right', suggestedMax: 100,
                            grid: { drawOnChartArea: false }, ticks: { callback: value => value + '%' }
                        }
                    }
                }
            });
        })();
    </script>
}
