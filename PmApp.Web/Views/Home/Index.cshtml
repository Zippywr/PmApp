@model PmApp.Web.Models.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<!-- ============================================== -->
<!-- SUMMARY CARDS -->
<!-- ============================================== -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Total Mesin</div>
                        <h3 class="mb-0">@Model.TotalAssets</h3>
                        <small class="text-success">
                            <i class="bi bi-check-circle"></i> @Model.ActiveAssets aktif
                        </small>
                    </div>
                    <i class="bi bi-gear text-primary" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Total Part</div>
                        <h3 class="mb-0">@Model.TotalParts</h3>
                        <small class="text-muted">
                            <i class="bi bi-diagram-3"></i> @Model.TotalBom BOM
                        </small>
                    </div>
                    <i class="bi bi-box-seam text-success" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Teknisi</div>
                        <h3 class="mb-0">@Model.TotalTechnicians</h3>
                    </div>
                    <i class="bi bi-person-badge text-warning" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">Mesin Critical</div>
                        <h3 class="mb-0 text-danger">@Model.CriticalAssets</h3>
                    </div>
                    <i class="bi bi-exclamation-triangle text-danger" style="font-size:2rem;"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ============================================== -->
<!-- MESIN TERBARU -->
<!-- ============================================== -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="bi bi-clock-history"></i> Mesin Terbaru</h6>
        <a asp-controller="Asset" asp-action="Index" class="btn btn-sm btn-outline-primary">
            Lihat Semua <i class="bi bi-arrow-right"></i>
        </a>
    </div>
    <div class="card-body p-0">
        @if (Model.RecentAssets.Count == 0)
        {
            <div class="text-center text-muted py-4">
                <i class="bi bi-inbox" style="font-size:2rem;"></i>
                <p class="mb-0 mt-2">Belum ada mesin</p>
                <a asp-controller="Asset" asp-action="Create" class="btn btn-sm btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Tambah Mesin
                </a>
            </div>
        }
        else
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Kode</th>
                        <th>Nama Mesin</th>
                        <th>Line</th>
                        <th>Kritikalitas</th>
                        <th class="text-center">Jumlah Part</th>
                        <th width="100"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model.RecentAssets)
                    {
                        <tr>
                            <td><strong>@a.Code</strong></td>
                            <td>@a.Name</td>
                            <td>@a.Line</td>
                            <td>
                                @switch (a.Criticality)
                                {
                                    case "Critical":
                                        <span class="badge bg-danger">Critical</span>
                                        break;
                                    case "High":
                                        <span class="badge bg-warning text-dark">High</span>
                                        break;
                                    case "Normal":
                                        <span class="badge bg-info text-dark">Normal</span>
                                        break;
                                    default:
                                        <span class="badge bg-secondary">Low</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-primary">@a.PartCount</span>
                            </td>
                            <td>
                                <a asp-controller="Asset" asp-action="Details" asp-route-id="@a.Id"
                                   class="btn btn-sm btn-info text-white">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>