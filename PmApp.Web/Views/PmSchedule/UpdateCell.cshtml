@model PmApp.Web.Models.ViewModels.PmUpdateCellViewModel
@{
    ViewData["Title"] = "Isi Pelaksanaan PM";
    bool canCorrect = (User.IsInRole("Admin") || User.IsInRole("TS"));
    bool isDone = Model.Status == PmApp.Web.Models.PmStatus.Done;
    bool canEdit = !isDone || canCorrect;
}

<style>
    .info-card {
        background: linear-gradient(135deg, #0d6efd 0%, #0a58ca 100%);
        color: #fff;
        border-radius: 0.75rem;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1rem;
    }

        .info-card .id-pm {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 1px;
        }

        .info-card .info-row {
            display: flex;
            flex-wrap: wrap;
            gap: 1rem 1.5rem;
            font-size: 0.9rem;
            margin-top: 0.5rem;
        }

        .info-card .info-item {
            display: flex;
            align-items: center;
            gap: 0.4rem;
        }

            .info-card .info-item i {
                opacity: 0.8;
            }

        .info-card .divider {
            border-top: 1px solid rgba(255, 255, 255, 0.25);
            margin: 0.75rem 0;
        }

    .form-section-title {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #6c757d;
        font-weight: 600;
        margin-bottom: 0.75rem;
        padding-bottom: 0.5rem;
        border-bottom: 1px solid #e9ecef;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

        .form-label i {
            color: #0d6efd;
            margin-right: 0.3rem;
        }

    .form-control, .form-select {
        border-radius: 0.5rem;
        padding: 0.6rem 0.9rem;
        font-size: 0.95rem;
        border-color: #dee2e6;
    }

        .form-control:focus, .form-select:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.15);
        }

    .help-text {
        font-size: 0.75rem;
        color: #6c757d;
        margin-top: 0.25rem;
        display: block;
    }

    .delay-badge {
        background: #fd7e14;
        color: #fff;
        padding: 0.35rem 0.75rem;
        border-radius: 2rem;
        font-size: 0.8rem;
        font-weight: 600;
    }
</style>

<!-- ============================================================ -->
<!-- BREADCRUMB                                                    -->
<!-- ============================================================ -->
<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">
            <a asp-action="ByMonth" asp-route-year="@Model.Year" asp-route-month="@Model.Month">
                <i class="bi bi-clipboard-check"></i> Pelaksanaan PM
            </a>
        </li>
        <li class="breadcrumb-item active">@(isDone ? "Detail PM" : "Isi PM")</li>
    </ol>
</nav>

<!-- ============================================================ -->
<!-- INFO TASK CARD                                                -->
<!-- ============================================================ -->
<div class="info-card">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
        <div>
            <div class="id-pm">@Model.IdPm</div>
            <div class="mt-1">
                <strong>@Model.AssetName</strong>
                <span class="opacity-75">— @Model.AssetCode</span>
            </div>
        </div>
        <div class="text-end">
            @if (Model.IsDelay)
            {
                <span class="delay-badge">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    Delay @Model.MonthsDelay bulan
                </span>
            }
            <div class="mt-2 small opacity-75">
                <i class="bi bi-calendar-event"></i> @Model.MonthName @Model.Year
            </div>
        </div>
    </div>

    <div class="divider"></div>

    <div class="info-row">
        @if (!string.IsNullOrEmpty(Model.LineName))
        {
            <div class="info-item">
                <i class="bi bi-diagram-2"></i>
                <span>Line: <strong>@Model.LineName</strong></span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.AreaName))
        {
            <div class="info-item">
                <i class="bi bi-geo-alt"></i>
                <span>Area: <strong>@Model.AreaName</strong></span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.UnitName))
        {
            <div class="info-item">
                <i class="bi bi-box-seam"></i>
                <span>Unit: <strong>@Model.UnitName</strong></span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.SubUnitName))
        {
            <div class="info-item">
                <i class="bi bi-nut"></i>
                <span>Sub Unit: <strong>@Model.SubUnitName</strong></span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.MethodName))
        {
            <div class="info-item">
                <i class="bi bi-gear"></i>
                <span>Metode: <strong>@Model.MethodName</strong></span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.StandardName))
        {
            <div class="info-item">
                <i class="bi bi-rulers"></i>
                <span>Standar: <strong>@Model.StandardName</strong></span>
            </div>
        }
        @if (Model.WorkHourMinutes > 0)
        {
            <div class="info-item">
                <i class="bi bi-clock-history"></i>
                <span>@Model.WorkHourMinutes menit</span>
            </div>
        }
        @if (Model.ManPower > 0)
        {
            <div class="info-item">
                <i class="bi bi-people"></i>
                <span>@Model.ManPower orang</span>
            </div>
        }
        @if (!string.IsNullOrEmpty(Model.MachineState))
        {
            <div class="info-item">
                <i class="bi bi-power"></i>
                <span>Mesin: <strong>@Model.MachineState</strong></span>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(Model.Remark))
    {
        <div class="divider"></div>
        <div class="small opacity-75">
            <i class="bi bi-info-circle"></i> @Model.Remark
        </div>
    }
</div>

<!-- ============================================================ -->
<!-- HASIL PELAKSANAAN: satu form utama untuk pengisian PM        -->
<!-- ============================================================ -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger" role="alert"><i class="bi bi-exclamation-triangle me-1"></i>@TempData["Error"]</div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
            <h5 class="mb-0"><i class="bi bi-clipboard-check text-primary me-1"></i> @(isDone ? "Hasil PM Selesai" : "Isi Hasil PM")</h5>
            @if (isDone)
            {
                <span class="badge bg-success"><i class="bi bi-lock-fill me-1"></i>Done</span>
            }
            else
            {

                <span class="badge bg-secondary">@Model.Status</span>
            }
        </div>

        @if (isDone && !canCorrect)
        {
            <div class="alert alert-info"><i class="bi bi-lock me-1"></i>PM ini sudah Done. Data hanya dapat dilihat oleh Line Head. Koreksi dilakukan oleh Admin.</div>
        }
        else if (isDone && canCorrect)
        {
            <div class="alert alert-warning"><i class="bi bi-pencil-square me-1"></i>Mode koreksi Admin. Perubahan akan masuk ke riwayat PM.</div>
        }

        <form asp-action="UpdateCell" asp-route-id="@Model.ScheduleId" method="post" class="form-confirm"
              data-confirm-title="Konfirmasi Selesai PM"
              data-confirm-message="Data akan disimpan sebagai Done dan terkunci bagi Line Head. Lanjutkan?"
              data-confirm-button="Ya, Simpan &amp; Done" data-loading-text="Menyimpan hasil PM...">
            @Html.AntiForgeryToken()

            <div class="form-section-title"><i class="bi bi-calendar-check me-1"></i> JADWAL</div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label">Rencana (Plan)</label>
                    <div class="form-control bg-light text-muted" aria-readonly="true">@(Model.PlanDate?.ToString("dd/MM/yyyy") ?? "Belum ditentukan")</div>
                    <span class="help-text">Jadwal hanya dapat diubah dari pengaturan Jadwal PM.</span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="actualDate"><i class="bi bi-calendar-check me-1"></i> Actual Date <span class="text-danger">*</span></label>
                    <input id="actualDate" name="actualDate" type="date" class="form-control"
                           value="@(Model.ActualDate?.ToString("yyyy-MM-dd"))" required disabled="@(!canEdit)" />
                    <span class="help-text">Tanggal pelaksanaan PM.</span>
                </div>
            </div>
            <div class="form-section-title mt-3"><i class="bi bi-person-check me-1"></i> PELAKSANAAN</div>
            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="pic"><i class="bi bi-person me-1"></i> PIC / Penanggung Jawab <span class="text-danger">*</span></label>
                    <input id="pic" name="pic" type="text" maxlength="200" class="form-control"
                           value="@Model.PIC" placeholder="Nama pelaksana" required disabled="@(!canEdit)" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">Status Setelah Simpan</label>
                    <div class="form-control bg-light"><span class="badge bg-success">Done</span></div>
                    <span class="help-text">Setelah Done, Line Head tidak dapat mengedit kembali.</span>
                </div>
            </div>
            <div class="form-section-title mt-3"><i class="bi bi-clipboard-check me-1"></i> HASIL</div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" for="result"><i class="bi bi-check2-circle me-1"></i> Result <span class="text-danger">*</span></label>
                    <select id="result" name="result" class="form-select" required disabled="@(!canEdit)">
                        <option value="">-- Pilih Result --</option>
                        @if (Model.Result == PmApp.Web.Models.MachineCondition.OK)
                        {
                            <option value="OK" selected>OK</option>
                        }
                        else
                        {
                            <option value="OK">OK</option>
                        }
                        @if (Model.Result == PmApp.Web.Models.MachineCondition.NG)
                        {
                            <option value="NG" selected>NG</option>
                        }
                        else
                        {
                            <option value="NG">NG</option>
                        }
                        @* Label baru Comment, penyimpanan tetap menggunakan enum Partial yang sudah ada *@
                        @if (Model.Result == PmApp.Web.Models.MachineCondition.Partial)
                        {
                            <option value="Partial" selected>Comment</option>
                        }
                        else
                        {
                            <option value="Partial">Comment</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="notes"><i class="bi bi-journal-text me-1"></i> Catatan <span class="text-danger" id="noteStar" style="display:none">*</span></label>
                    <textarea id="notes" name="notes" rows="3" maxlength="500" class="form-control"
                              placeholder="Keterangan tambahan (opsional)" disabled="@(!canEdit)">@Model.Notes</textarea>
                    <span class="help-text">Wajib diisi jika Result = Comment.</span>
                </div>
            </div>
            <hr class="my-4" />
            <div class="d-flex align-items-center flex-wrap gap-2">
                @if (canEdit)
                {
                    <button type="submit" class="btn btn-success btn-lg"><i class="bi bi-check-circle me-1"></i> @(isDone ? "Simpan Koreksi" : "Simpan & Done")</button>
                }
                <a asp-action="ByMonth" asp-route-year="@Model.Year" asp-route-month="@Model.Month" class="btn btn-outline-secondary btn-lg">
                    <i class="bi bi-arrow-left me-1"></i> Kembali ke Pelaksanaan PM
                </a>
                <a asp-action="History" asp-route-id="@Model.ScheduleId" class="btn btn-outline-info btn-lg"><i class="bi bi-clock-history me-1"></i> Riwayat</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const result = document.getElementById('result');
            const notes = document.getElementById('notes');
            const star = document.getElementById('noteStar');
            if (!result || !notes || !star) return;
            function syncNotes() {
                const required = result.value === 'Partial' && !result.disabled;
                notes.required = required;
                star.style.display = required ? '' : 'none';
            }
            result.addEventListener('change', syncNotes);
            syncNotes();
        })();
    </script>
}
