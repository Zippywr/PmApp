@model PmApp.Web.Models.ViewModels.PmMonthViewModel
@{
    ViewData["Title"] = "Update PM per Bulan";
    var monthNames = new[] { "", "Januari", "Februari", "Maret", "April", "Mei", "Juni", "Juli", "Agustus", "September", "Oktober", "November", "Desember" };
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        <i class="bi bi-check-circle"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
    <h4 class="mb-0"><i class="bi bi-calendar-month"></i> Update PM per Bulan</h4>
</div>

<!-- FILTER BULAN -->
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label">Bulan</label>
                <select name="month" class="form-select">
                    @for (int m = 1; m <= 12; m++)
                    {
                        if (Model.Month == m)
                        {
                            <option value="@m" selected>@monthNames[m]</option>
                        }
                        else
                        {
                            <option value="@m">@monthNames[m]</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Tahun</label>
                <input type="number" name="year" class="form-control" value="@Model.Year" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search"></i> Tampilkan
                </button>
                <a asp-action="ByMonth" class="btn btn-secondary">Bulan Ini</a>
            </div>
            <div class="col-md-5 text-end">
                <div class="small text-muted">
                    Periode:
                    <strong>@Model.MonthName @Model.Year</strong>
                </div>
            </div>
        </form>
    </div>
</div>

<!-- SUMMARY -->
<div class="row g-3 mb-3">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-primary">
            <div class="card-body text-center">
                <div class="small opacity-75">Total Task</div>
                <h4 class="mb-0">@Model.TotalTask</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-success">
            <div class="card-body text-center">
                <div class="small opacity-75">Done</div>
                <h4 class="mb-0">@Model.TotalDone</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-warning">
            <div class="card-body text-center">
                <div class="small opacity-75">Pending</div>
                <h4 class="mb-0">@Model.TotalPending</h4>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm text-white bg-delay">
            <div class="card-body text-center">
                <div class="small opacity-75">Delay</div>
                <h4 class="mb-0">@Model.TotalDelay</h4>
            </div>
        </div>
    </div>
</div>

@if (!Model.Weeks.Any() || Model.TotalTask == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i>
        Tidak ada jadwal PM di bulan ini. Coba pilih bulan lain.
    </div>
}
else
{
    <form asp-action="UpdateMonth" method="post" class="form-confirm" data-confirm-title="Konfirmasi Update Bulanan" data-confirm-message="Simpan perubahan PM bulan ini?" data-confirm-button="Ya, Simpan" data-loading-text="Memperbarui PM bulanan...">
        @Html.AntiForgeryToken()
        <input type="hidden" name="year" value="@Model.Year" />
        <input type="hidden" name="month" value="@Model.Month" />

        @foreach (var week in Model.Weeks)
        {
            if (!week.Rows.Any()) continue;

            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-light d-flex justify-content-between align-items-center"
                     data-bs-toggle="collapse"
                     data-bs-target="#week-@week.WeekNumber"
                     style="cursor: pointer;">
                    <div>
                        <i class="bi bi-calendar-week text-primary"></i>
                        <strong class="ms-2">@week.WeekLabel</strong>
                    </div>
                    <div class="d-flex gap-2">
                        <span class="badge bg-primary">@week.TotalTask task</span>
                        <span class="badge bg-success">@week.TotalDone done</span>
                        <span class="badge bg-warning text-dark">@week.TotalPending pending</span>
                        @if (week.TotalDelay > 0)
                        {
                            <span class="badge bg-delay">@week.TotalDelay delay</span>
                        }
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>

                <div id="week-@week.WeekNumber" class="collapse show">
                    <div class="card-body p-0" style="overflow-x: auto;">
                        <table class="table table-hover table-sm mb-0" style="font-size: 0.85rem;">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width: 90px;">ID-PM</th>
                                    <th style="min-width: 140px;">Mesin</th>
                                    <th style="min-width: 110px;">Sub Unit</th>
                                    <th style="min-width: 80px;">Metode</th>
                                    <th class="text-center" style="width: 50px;">W/H</th>
                                    <th class="text-center" style="width: 40px;">MP</th>
                                    <th style="min-width: 120px;">Plan</th>
                                    <th style="min-width: 120px;">Actual</th>
                                    <th style="min-width: 130px;">PIC</th>
                                    <th style="min-width: 110px;">Status</th>
                                    <th style="min-width: 110px;">Hasil</th>
                                    <th style="min-width: 160px;">Catatan</th>
                                    <th class="text-center" style="min-width: 140px;">Aksi</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in week.Rows)
                                {
                                    <tr>
                                        <td>
                                            <strong>@row.IdPm</strong>
                                            <input type="hidden" name="scheduleIds" value="@row.ScheduleId" />
                                        </td>
                                        <td>
                                            @row.AssetCode
                                            <br />
                                            <small class="text-muted">@row.AssetName</small>
                                        </td>
                                        <td>@row.SubUnitName</td>
                                        <td><span class="badge bg-secondary">@row.MethodName</span></td>
                                        <td class="text-center">@row.WorkHourMinutes</td>
                                        <td class="text-center">@row.ManPower</td>

                                        <td>
                                            <input type="date" name="planDates" class="form-control form-control-sm"
                                                   value="@(row.PlanDate?.ToString("yyyy-MM-dd"))" />
                                        </td>

                                        <td>
                                            <input type="date" name="actualDates" class="form-control form-control-sm"
                                                   value="@(row.ActualDate?.ToString("yyyy-MM-dd"))" />
                                        </td>

                                        <td>
                                            <input type="text" name="pics" class="form-control form-control-sm"
                                                   value="@row.PIC" placeholder="PIC" />
                                        </td>

                                        <td>
                                            <select name="statuses" class="form-select form-select-sm">
                                                @foreach (var s in Enum.GetNames(typeof(PmApp.Web.Models.PmStatus)))
                                                {
                                                    var label = s == "Overdue" ? "Delay" : s;
                                                    if (row.Status.ToString() == s)
                                                    {
                                                        <option value="@s" selected>@label</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@s">@label</option>
                                                    }
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <select name="results" class="form-select form-select-sm">
                                                @foreach (var r in Enum.GetNames(typeof(PmApp.Web.Models.MachineCondition)))
                                                {
                                                    if (row.Result.ToString() == r)
                                                    {
                                                        <option value="@r" selected>@r</option>
                                                    }
                                                    else
                                                    {
                                                        <option value="@r">@r</option>
                                                    }
                                                }
                                            </select>
                                        </td>

                                        <td>
                                            <input type="text" name="notes" class="form-control form-control-sm"
                                                   value="@row.Notes" placeholder="Catatan" />
                                        </td>

                                        <td class="text-center">
                                            <a asp-controller="PmSchedule" asp-action="UpdateCell"
                                               asp-route-id="@row.ScheduleId"
                                               class="btn btn-sm btn-warning mb-1"
                                               title="Update via Form Lengkap">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-controller="PmSchedule" asp-action="History"
                                               asp-route-id="@row.ScheduleId"
                                               class="btn btn-sm btn-info text-white mb-1"
                                               title="History">
                                                <i class="bi bi-clock-history"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }

        <div class="card border-0 shadow-sm">
            <div class="card-body text-end">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-save"></i> Simpan Semua (@Model.TotalTask task)
                </button>
            </div>
        </div>
    </form>
}