@model PmApp.Web.Models.ViewModels.TechnicianFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<!-- ============================================== -->
<!-- IDENTITAS -->
<!-- ============================================== -->
<h6 class="text-muted mb-3"><i class="bi bi-person"></i> Identitas Teknisi</h6>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Code" class="form-label"></label>
        <input asp-for="Code" class="form-control" placeholder="Contoh: TEK-001" />
        <span asp-validation-for="Code" class="text-danger small"></span>
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" placeholder="Contoh: Budi Santoso" />
        <span asp-validation-for="Name" class="text-danger small"></span>
    </div>
</div>

<!-- ============================================== -->
<!-- KEAHLIAN -->
<!-- ============================================== -->
<h6 class="text-muted mb-3 mt-2"><i class="bi bi-tools"></i> Keahlian & Shift</h6>
<div class="row">
    <div class="col-md-6 mb-3">
        <label asp-for="Skill" class="form-label"></label>
        <input asp-for="Skill" class="form-control"
               placeholder="Contoh: Mechanical / Electrical / Automation" />
    </div>
    <div class="col-md-6 mb-3">
        <label asp-for="Shift" class="form-label"></label>
        <input asp-for="Shift" class="form-control"
               placeholder="Contoh: Shift-1 / Shift-2 / Shift-3" />
    </div>
</div>

<!-- ============================================== -->
<!-- KONTAK -->
<!-- ============================================== -->
<h6 class="text-muted mb-3 mt-2"><i class="bi bi-telephone"></i> Kontak</h6>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" placeholder="0812xxxxxxx" />
        <span asp-validation-for="Phone" class="text-danger small"></span>
    </div>
    <div class="col-md-8 mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" type="email" class="form-control"
               placeholder="nama@perusahaan.com" />
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>
</div>

<!-- ============================================== -->
<!-- STATUS -->
<!-- ============================================== -->
<div class="row">
    <div class="col-md-12 mb-3">
        <div class="form-check">
            <input asp-for="IsActive" class="form-check-input" />
            <label asp-for="IsActive" class="form-check-label"></label>
            <small class="text-muted d-block">
                Nonaktifkan kalau teknisi sudah tidak bekerja di sini.
            </small>
        </div>
    </div>
</div>