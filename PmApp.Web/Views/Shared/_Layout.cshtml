<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PM System</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <style>
            html, body {
                height: 100%;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }

            .app-wrapper {
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* ============================================================
                       SIDEBAR
                       ============================================================ */
            .app-sidebar {
                width: 240px;
                background-color: #1e293b;
                color: #e2e8f0;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                flex-shrink: 0;
            }

                .app-sidebar .brand {
                    padding: 1rem;
                    font-size: 1.1rem;
                    font-weight: 700;
                    border-bottom: 1px solid #334155;
                    color: #fff;
                }

                .app-sidebar .nav-link {
                    color: #cbd5e1;
                    padding: 0.6rem 1rem;
                    border-radius: 0.375rem;
                    margin: 0.15rem 0.5rem;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    font-size: 0.9rem;
                }

                    .app-sidebar .nav-link:hover {
                        background-color: #334155;
                        color: #fff;
                    }

                    .app-sidebar .nav-link.active {
                        background-color: #0d6efd;
                        color: #fff;
                    }

                .app-sidebar .nav-section {
                    font-size: 0.7rem;
                    text-transform: uppercase;
                    color: #94a3b8;
                    padding: 1rem 1rem 0.4rem;
                    letter-spacing: 0.05em;
                }

            /* ============================================================
                       MAIN
                       ============================================================ */
            .app-main {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
            }

            .app-topbar {
                background-color: #f8fafc;
                border-bottom: 1px solid #e2e8f0;
                padding: 0.75rem 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
            }

            .app-content {
                flex: 1;
                overflow-y: auto;
                padding: 1.5rem;
                background-color: #f1f5f9;
            }

            /* ============================================================
                       ROW CLICKABLE — klik baris langsung buka detail
                       ============================================================ */
            table.datatable tbody tr.row-clickable {
                cursor: pointer;
                transition: background-color 0.15s;
            }

                table.datatable tbody tr.row-clickable:hover {
                    background-color: #e7f1ff !important;
                }

                /* Link di dalam row — tetap bisa diklik, tapi tidak trigger row click */
                table.datatable tbody tr.row-clickable a {
                    text-decoration: none;
                    color: #0d6efd;
                    font-weight: 500;
                }

                    table.datatable tbody tr.row-clickable a:hover {
                        text-decoration: underline;
                    }
    </style>
</head>
<body>
    <div class="app-wrapper">
        <!-- ============================================================
             SIDEBAR
             ============================================================ -->
        <aside class="app-sidebar">
            <div class="brand">
                <i class="bi bi-gear-wide-connected"></i> PM System
            </div>
            <nav class="flex-grow-1 py-2">
                <div class="nav-section">Utama</div>
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i> Dashboard
                </a>

                <div class="nav-section">Master Data</div>
                <a class="nav-link" asp-controller="Asset" asp-action="Index">
                    <i class="bi bi-gear"></i> Mesin
                </a>
                <a class="nav-link" asp-controller="Part" asp-action="Index">
                    <i class="bi bi-box-seam"></i> Part
                </a>
                <a class="nav-link" asp-controller="Technician" asp-action="Index">
                    <i class="bi bi-person-badge"></i> Teknisi
                </a>

                <div class="nav-section">Preventive</div>
                <a class="nav-link" href="#">
                    <i class="bi bi-calendar-event"></i> Jadwal PM
                </a>
                <a class="nav-link" href="#">
                    <i class="bi bi-clipboard-check"></i> Work Order
                </a>
            </nav>
            <div class="p-3 small text-muted border-top border-secondary">
                <i class="bi bi-info-circle"></i> Versi 1.0 — Lokal
            </div>
        </aside>

        <!-- ============================================================
             MAIN CONTENT
             ============================================================ -->
        <main class="app-main">
            <header class="app-topbar">
                <h6 class="mb-0 text-secondary">
                    @ViewData["Title"]
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-person-circle"></i> system
                    </span>
                </div>
            </header>

            <div class="app-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- ============================================================
         SCRIPTS
         ============================================================ -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            $(document).ready(function () {

                // ============================================================
                // INIT DATATABLES
                // ============================================================
                $('.datatable').DataTable({
                    language: {
                        search: "Cari:",
                        lengthMenu: "Tampilkan _MENU_ data",
                        info: "Menampilkan _START_ - _END_ dari _TOTAL_ data",
                        infoEmpty: "Tidak ada data",
                        zeroRecords: "Data tidak ditemukan",
                        paginate: {
                            first: "Awal",
                            last: "Akhir",
                            next: "Berikutnya",
                            previous: "Sebelumnya"
                        }
                    },
                    pageLength: 10,
                    order: []
                });

                // ============================================================
                // ROW CLICKABLE — klik baris → buka data-href
                // ============================================================
                $(document).on('click', 'table.datatable tbody tr.row-clickable', function (e) {

                    // Jangan trigger kalau yang diklik: button, link, form,
                    // checkbox, ikon di dalam button, atau elemen .no-row-click
                    if ($(e.target).closest('button, a, form, input, select, textarea, .no-row-click').length) {
                        return;
                    }

                    var url = $(this).data('href');
                    if (url) {
                        window.location.href = url;
                    }
                });

                // ============================================================
                // TOOLTIP (opsional) — aktifkan tooltip Bootstrap
                // ============================================================
                var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (el) {
                    return new bootstrap.Tooltip(el);
                });
            });
    </script>
</body>
</html>