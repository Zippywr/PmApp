<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PM System</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <!-- DataTables -->
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <style>
            html, body {
                height: 100%;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }

            .app-wrapper {
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* ============================================
                       SIDEBAR
                       ============================================ */
            .app-sidebar {
                width: 250px;
                background-color: #02474d;
                color: #e2e8f0;
                display: flex;
                flex-direction: column;
                overflow-y: auto;
                flex-shrink: 0;
                transition: width 0.2s;
            }

                .app-sidebar.collapsed {
                    width: 70px;
                }

                .app-sidebar .brand {
                    padding: 1rem;
                    font-size: 1.1rem;
                    font-weight: 700;
                    border-bottom: 1px solid #334155;
                    color: #fff;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    white-space: nowrap;
                }

                .app-sidebar .brand-text {
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .app-sidebar.collapsed .brand-text {
                    display: none;
                }

            /* ============================================
                       MENU GROUP (COLLAPSIBLE)
                       ============================================ */
            .menu-group {
                margin-bottom: 0.25rem;
            }

            .menu-group-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0.65rem 1rem;
                color: #94a3b8;
                font-size: 0.72rem;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                font-weight: 700;
                cursor: pointer;
                user-select: none;
                border: none;
                background: none;
                width: 100%;
                text-align: left;
                transition: background 0.15s, color 0.15s;
            }

                .menu-group-header:hover {
                    background-color: #334155;
                    color: #fff;
                }

                .menu-group-header .group-icon {
                    font-size: 0.95rem;
                    min-width: 20px;
                    text-align: center;
                    margin-right: 0.5rem;
                }

                .menu-group-header .group-label {
                    flex: 1;
                }

                .menu-group-header .group-chevron {
                    font-size: 0.7rem;
                    transition: transform 0.25s;
                    color: #64748b;
                }

            .menu-group.open .menu-group-header .group-chevron {
                transform: rotate(90deg);
                color: #0d6efd;
            }

            .menu-group.open .menu-group-header {
                color: #fff;
            }

            /* Submenu */
            .menu-group-body {
                overflow: hidden;
                max-height: 0;
                transition: max-height 0.3s ease-out;
            }

            .menu-group.open .menu-group-body {
                max-height: 400px;
                transition: max-height 0.4s ease-in;
            }

            /* Link submenu */
            .app-sidebar .nav-link {
                color: #cbd5e1;
                padding: 0.55rem 0.9rem 0.55rem 2.5rem;
                border-radius: 0.375rem;
                margin: 0.1rem 0.5rem;
                display: flex;
                align-items: center;
                gap: 0.7rem;
                font-size: 0.85rem;
                white-space: nowrap;
                text-decoration: none;
                transition: background 0.15s;
                position: relative;
            }

                .app-sidebar .nav-link::before {
                    content: "";
                    position: absolute;
                    left: 1.5rem;
                    top: 50%;
                    width: 4px;
                    height: 4px;
                    border-radius: 50%;
                    background-color: #64748b;
                    transform: translateY(-50%);
                    transition: background 0.15s;
                }

                .app-sidebar .nav-link i {
                    font-size: 0.95rem;
                    min-width: 20px;
                    text-align: center;
                }

                .app-sidebar .nav-link:hover {
                    background-color: #334155;
                    color: #fff;
                }

                    .app-sidebar .nav-link:hover::before {
                        background-color: #94a3b8;
                    }

                .app-sidebar .nav-link.active {
                    background-color: #0d6efd;
                    color: #fff;
                }

                    .app-sidebar .nav-link.active::before {
                        background-color: #fff;
                    }

                /* Standalone link (Dashboard) */
                .app-sidebar .nav-link.standalone {
                    padding-left: 1rem;
                    margin: 0.25rem 0.5rem;
                }

                    .app-sidebar .nav-link.standalone::before {
                        display: none;
                    }

            /* Footer */
            .app-sidebar .sidebar-footer {
                padding: 0.75rem 1rem;
                font-size: 0.75rem;
                color: #64748b;
                border-top: 1px solid #334155;
                margin-top: auto;
                white-space: nowrap;
            }

            /* Toggle */
            .sidebar-toggle {
                background: none;
                border: none;
                color: #94a3b8;
                padding: 0.25rem 0.5rem;
                border-radius: 0.25rem;
                cursor: pointer;
                margin-left: auto;
            }

                .sidebar-toggle:hover {
                    background-color: #334155;
                    color: #fff;
                }

            /* Collapsed sidebar */
            .app-sidebar.collapsed .menu-group-header .group-label,
            .app-sidebar.collapsed .menu-group-header .group-chevron,
            .app-sidebar.collapsed .nav-link span {
                display: none;
            }

            .app-sidebar.collapsed .menu-group-header {
                justify-content: center;
                padding: 0.65rem 0;
            }

                .app-sidebar.collapsed .menu-group-header .group-icon {
                    margin-right: 0;
                }

            .app-sidebar.collapsed .nav-link {
                padding: 0.55rem 0;
                justify-content: center;
            }

                .app-sidebar.collapsed .nav-link::before {
                    display: none;
                }

                .app-sidebar.collapsed .nav-link i {
                    margin: 0;
                }

            /* ============================================
                       MAIN AREA
                       ============================================ */
            .app-main {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                min-width: 0;
            }

            .app-topbar {
                background-color: #f8fafc;
                border-bottom: 1px solid #e2e8f0;
                padding: 0.75rem 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
            }

            .app-content {
                flex: 1;
                overflow-y: auto;
                padding: 1.5rem;
                background-color: #f1f5f9;
            }
    </style>
</head>
<body>
    <div class="app-wrapper">

        <!-- ================================================
             SIDEBAR
             ================================================ -->
        <aside class="app-sidebar" id="sidebar">

            <!-- BRAND -->
            <div class="brand">
                <i class="bi bi-gear-wide-connected"></i>
                <span class="brand-text">PM System</span>
                <button class="sidebar-toggle" onclick="toggleSidebar()" title="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <!-- NAVIGATION -->
            <nav class="flex-grow-1 py-2">

                <!-- ============ DASHBOARD (standalone) ============ -->
                <a class="nav-link standalone" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <!-- ============ MASTER DATA ============ -->
                <div class="menu-group" data-group="masterdata">
                    <button class="menu-group-header" onclick="toggleGroup('masterdata')">
                        <i class="bi bi-database group-icon"></i>
                        <span class="group-label">Master Data</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="Asset" asp-action="Index">
                            <i class="bi bi-gear"></i>
                            <span>Mesin</span>
                        </a>
                        <a class="nav-link" asp-controller="Part" asp-action="Index">
                            <i class="bi bi-box-seam"></i>
                            <span>Part</span>
                        </a>
                        <a class="nav-link" asp-controller="Bom" asp-action="Index">
                            <i class="bi bi-diagram-3"></i>
                            <span>Pemasangan (BOM)</span>
                        </a>
                    </div>
                </div>

                <!-- ============ SCHEDULE ============ -->
                <div class="menu-group" data-group="schedule">
                    <button class="menu-group-header" onclick="toggleGroup('schedule')">
                        <i class="bi bi-calendar-event group-icon"></i>
                        <span class="group-label">Schedule</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="PmSchedule" asp-action="InputPm">
                            <i class="bi bi-pencil-square"></i>
                            <span>Input PM</span>
                        </a>
                        <a class="nav-link" asp-controller="PmSchedule" asp-action="Index">
                            <i class="bi bi-calendar-week"></i>
                            <span>Jadwal PM</span>
                        </a>
                        <a class="nav-link" asp-controller="Export" asp-action="Schedule">
                            <i class="bi bi-download"></i>
                            <span>Export Schedule</span>
                        </a>
                    </div>
                </div>

                <!-- ============ IMPLEMENTATION ============ -->
                <div class="menu-group" data-group="implementation">
                    <button class="menu-group-header" onclick="toggleGroup('implementation')">
                        <i class="bi bi-tools group-icon"></i>
                        <span class="group-label">Implementation</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="PmUpdate" asp-action="ByPart">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Update PM per Part</span>
                        </a>
                        <a class="nav-link" asp-controller="PmUpdate" asp-action="ByWeek">
                            <i class="bi bi-calendar3-week"></i>
                            <span>Update PM per Week</span>
                        </a>
                    </div>
                </div>

                <!-- ============ REPORT ============ -->
                <div class="menu-group" data-group="report">
                    <button class="menu-group-header" onclick="toggleGroup('report')">
                        <i class="bi bi-file-earmark-bar-graph group-icon"></i>
                        <span class="group-label">Report</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="Report" asp-action="PmSchedule">
                            <i class="bi bi-table"></i>
                            <span>Report PM Schedule</span>
                        </a>
                        <a class="nav-link" asp-controller="Report" asp-action="PmGraph">
                            <i class="bi bi-graph-up"></i>
                            <span>Report PM Graph</span>
                        </a>
                    </div>
                </div>

            </nav>

            <!-- FOOTER -->
            <div class="sidebar-footer">
                <i class="bi bi-info-circle"></i>
                <span class="brand-text">Versi 1.0 — Lokal</span>
            </div>
        </aside>

        <!-- ================================================
             MAIN
             ================================================ -->
        <main class="app-main">
            <header class="app-topbar">
                <h6 class="mb-0 text-secondary">
                    <i class="bi bi-folder2-open"></i>
                    @ViewData["Title"]
                </h6>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-person-circle"></i> system
                    </span>
                </div>
            </header>

            <div class="app-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- ================================================
         SCRIPTS
         ================================================ -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            // ============================================
            // TOGGLE GROUP (COLLAPSIBLE MENU)
            // ============================================
            function toggleGroup(groupName) {
                const group = document.querySelector(`.menu-group[data-group="${groupName}"]`);
                if (!group) return;

                const isOpen = group.classList.contains('open');

                // Tutup grup lain (accordion mode — hanya 1 terbuka)
                document.querySelectorAll('.menu-group.open').forEach(g => {
                    if (g !== group) g.classList.remove('open');
                });

                // Toggle grup yang diklik
                if (isOpen) {
                    group.classList.remove('open');
                    localStorage.removeItem('menuOpen');
                } else {
                    group.classList.add('open');
                    localStorage.setItem('menuOpen', groupName);
                }
            }

            // ============================================
            // AUTO-OPEN GROUP BERDASARKAN URL
            // ============================================
            function autoOpenByUrl() {
                const path = window.location.pathname.toLowerCase();

                const urlMap = {
                    'masterdata':    ['/asset', '/part', '/bom'],
                    'schedule':      ['/pmschedule', '/export'],
                    'implementation':['/pmupdate'],
                    'report':        ['/report']
                };

                for (const [groupName, prefixes] of Object.entries(urlMap)) {
                    if (prefixes.some(p => path.startsWith(p))) {
                        const group = document.querySelector(`.menu-group[data-group="${groupName}"]`);
                        if (group) group.classList.add('open');
                        localStorage.setItem('menuOpen', groupName);
                        return;
                    }
                }

                // Kalau tidak ada yang cocok, buka yang terakhir dibuka
                const lastOpen = localStorage.getItem('menuOpen');
                if (lastOpen) {
                    const group = document.querySelector(`.menu-group[data-group="${lastOpen}"]`);
                    if (group) group.classList.add('open');
                }
            }

            // ============================================
            // HIGHLIGHT LINK AKTIF
            // ============================================
            function highlightActiveLink() {
                const path = window.location.pathname.toLowerCase();

                document.querySelectorAll('.app-sidebar .nav-link').forEach(link => {
                    link.classList.remove('active');
                    const href = link.getAttribute('href');
                    if (!href) return;

                    const hrefLower = href.toLowerCase();
                    if (hrefLower === '/' && path === '/') {
                        link.classList.add('active');
                    } else if (hrefLower !== '/' && path.startsWith(hrefLower)) {
                        link.classList.add('active');
                    }
                });
            }

            // ============================================
            // TOGGLE SIDEBAR COLLAPSE
            // ============================================
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                sidebar.classList.toggle('collapsed');
                localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
            }

            // ============================================
            // INIT SAAT HALAMAN DIMUAT
            // ============================================
            document.addEventListener('DOMContentLoaded', function () {
                // Restore sidebar collapse
                if (localStorage.getItem('sidebarCollapsed') === 'true') {
                    document.getElementById('sidebar').classList.add('collapsed');
                }

                autoOpenByUrl();
                highlightActiveLink();

                // Init DataTables
                if (typeof $ !== 'undefined' && $.fn.DataTable) {
                    $('.datatable').DataTable({
                        language: {
                            search: "Cari:",
                            lengthMenu: "Tampilkan _MENU_ data",
                            info: "Menampilkan _START_ - _END_ dari _TOTAL_ data",
                            infoEmpty: "Tidak ada data",
                            zeroRecords: "Data tidak ditemukan",
                            paginate: {
                                first: "Awal",
                                last: "Akhir",
                                next: "Berikutnya",
                                previous: "Sebelumnya"
                            }
                        },
                        pageLength: 10,
                        order: []
                    });
                }
            });
    </script>
</body>
</html>