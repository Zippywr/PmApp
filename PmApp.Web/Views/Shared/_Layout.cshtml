<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PM System</title>

    <!-- Bootstrap 5 (CDN) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            font-size: 15px;
        }

        .app-wrapper {
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* ============================================
           SIDEBAR
           ============================================ */
        .app-sidebar {
            width: 250px;
            background-color: #1e293b;
            color: #e2e8f0;
            display: flex;
            flex-direction: column;
            flex-shrink: 0;
            transition: width 0.2s;
        }

        .app-sidebar.collapsed {
            width: 65px;
        }

        /* Brand */
        .app-sidebar .brand {
            padding: 1rem;
            font-size: 1.1rem;
            font-weight: 700;
            border-bottom: 1px solid #334155;
            color: #fff;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            white-space: nowrap;
            flex-shrink: 0;
        }

        .app-sidebar .brand-text {
            overflow: hidden;
            text-overflow: ellipsis;
            flex: 1;
        }

        .app-sidebar.collapsed .brand-text {
            display: none;
        }

        .sidebar-toggle {
            background: none;
            border: none;
            color: #94a3b8;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            cursor: pointer;
        }

        .sidebar-toggle:hover {
            background-color: #334155;
            color: #fff;
        }

        /* ============================================
           NAV SCROLLABLE
           ============================================ */
        .sidebar-nav {
            flex: 1;
            overflow-y: auto;
            overflow-x: hidden;
            padding: 0.5rem 0;
        }

        .sidebar-nav::-webkit-scrollbar { width: 8px; }
        .sidebar-nav::-webkit-scrollbar-track { background: #1e293b; }
        .sidebar-nav::-webkit-scrollbar-thumb {
            background: #475569;
            border-radius: 4px;
        }
        .sidebar-nav::-webkit-scrollbar-thumb:hover { background: #64748b; }

        /* ============================================
           MENU GROUP (COLLAPSIBLE)
           ============================================ */
        .menu-group {
            margin-bottom: 0.2rem;
        }

        .menu-group-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.7rem 1rem;
            color: #cbd5e1;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            user-select: none;
            border: none;
            background: none;
            width: 100%;
            text-align: left;
            transition: background 0.15s, color 0.15s;
            white-space: nowrap;
        }

        .menu-group-header:hover {
            background-color: #334155;
            color: #fff;
        }

        .menu-group-header .group-icon {
            font-size: 1rem;
            min-width: 22px;
            text-align: center;
            margin-right: 0.6rem;
        }

        .menu-group-header .group-label {
            flex: 1;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .menu-group-header .group-chevron {
            font-size: 0.75rem;
            transition: transform 0.25s;
            color: #64748b;
        }

        .menu-group.open .menu-group-header .group-chevron {
            transform: rotate(90deg);
            color: #60a5fa;
        }

        .menu-group.open .menu-group-header {
            color: #fff;
        }

        /* Submenu */
        .menu-group-body {
            overflow: hidden;
            max-height: 0;
            transition: max-height 0.35s ease;
        }

        .menu-group.open .menu-group-body {
            max-height: 600px;
        }

        /* ============================================
           NAV LINK
           ============================================ */
        .sidebar-nav .nav-link {
            color: #cbd5e1;
            padding: 0.6rem 1rem 0.6rem 2.75rem;
            display: flex;
            align-items: center;
            gap: 0.7rem;
            font-size: 0.875rem;
            white-space: nowrap;
            text-decoration: none;
            transition: background 0.15s, color 0.15s;
            position: relative;
            border-left: 3px solid transparent;
        }

        .sidebar-nav .nav-link i {
            font-size: 0.95rem;
            min-width: 20px;
            text-align: center;
            flex-shrink: 0;
        }

        .sidebar-nav .nav-link span {
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .sidebar-nav .nav-link:hover {
            background-color: #334155;
            color: #fff;
        }

        .sidebar-nav .nav-link.active {
            background-color: #1e40af;
            color: #fff;
            border-left-color: #60a5fa;
            font-weight: 500;
        }

        /* Standalone link (Dashboard) */
        .sidebar-nav .nav-link.standalone {
            padding-left: 1rem;
        }

        /* Collapsed sidebar */
        .app-sidebar.collapsed .menu-group-header .group-label,
        .app-sidebar.collapsed .menu-group-header .group-chevron,
        .app-sidebar.collapsed .nav-link span {
            display: none;
        }

        .app-sidebar.collapsed .menu-group-header {
            justify-content: center;
            padding: 0.7rem 0;
        }

        .app-sidebar.collapsed .menu-group-header .group-icon {
            margin-right: 0;
        }

        .app-sidebar.collapsed .nav-link {
            padding: 0.6rem 0;
            justify-content: center;
        }

        /* ============================================
           FOOTER
           ============================================ */
        .sidebar-footer {
            padding: 0.75rem 1rem;
            font-size: 0.75rem;
            color: #64748b;
            border-top: 1px solid #334155;
            flex-shrink: 0;
            white-space: nowrap;
        }

        /* ============================================
           MAIN AREA
           ============================================ */
        .app-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            min-width: 0;
        }

        .app-topbar {
            background-color: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 0.85rem 1.5rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            flex-shrink: 0;
        }

        .app-content {
            flex: 1;
            overflow-y: auto;
            padding: 1.5rem;
            background-color: #f1f5f9;
        }
    </style>
</head>
<body>
    <div class="app-wrapper">

        <!-- ================================================
             SIDEBAR
             ================================================ -->
        <aside class="app-sidebar" id="sidebar">

            <!-- BRAND -->
            <div class="brand">
                <i class="bi bi-gear-wide-connected"></i>
                <span class="brand-text">PM System</span>
                <button class="sidebar-toggle" onclick="toggleSidebar()" title="Toggle sidebar">
                    <i class="bi bi-list"></i>
                </button>
            </div>

            <!-- NAV SCROLLABLE -->
            <nav class="sidebar-nav">

                <!-- ============ DASHBOARD (standalone) ============ -->
                <a class="nav-link standalone" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <!-- ============ MASTER DATA ============ -->
                <div class="menu-group" data-group="masterdata">
                    <button class="menu-group-header" onclick="toggleGroup('masterdata')">
                        <i class="bi bi-database group-icon"></i>
                        <span class="group-label">Data Master</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="Plant" asp-action="Index">
                            <i class="bi bi-building"></i>
                            <span>Plant</span>
                        </a>
                        <a class="nav-link" asp-controller="Line" asp-action="Index">
                            <i class="bi bi-diagram-2"></i>
                            <span>Line</span>
                        </a>
                        <a class="nav-link" asp-controller="Area" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap"></i>
                            <span>Area</span>
                        </a>
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box"></i>
                            <span>Product</span>
                        </a>
                        <a class="nav-link" asp-controller="Brand" asp-action="Index">
                            <i class="bi bi-award"></i>
                            <span>Brand</span>
                        </a>
                        <a class="nav-link" asp-controller="McCategory" asp-action="Index">
                            <i class="bi bi-cpu"></i>
                            <span>Kategori Mesin</span>
                        </a>
                        <a class="nav-link" asp-controller="MachineFunction" asp-action="Index">
                            <i class="bi bi-tools"></i>
                            <span>Fungsi Mesin</span>
                        </a>
                        <a class="nav-link" asp-controller="Asset" asp-action="Index">
                            <i class="bi bi-gear"></i>
                            <span>Mesin</span>
                        </a>
                        <a class="nav-link" asp-controller="Part" asp-action="Index">
                            <i class="bi bi-box-seam"></i>
                            <span>Part</span>
                        </a>
                        <a class="nav-link" asp-controller="Bom" asp-action="Index">
                            <i class="bi bi-diagram-3"></i>
                            <span>Pemasangan (BOM)</span>
                        </a>
                        <!-- Klasifikasi PM -->
                        <a class="nav-link" asp-controller="Unit" asp-action="Index">
                            <i class="bi bi-cpu"></i>
                            <span>Unit</span>
                        </a>
                        <a class="nav-link" asp-controller="SubUnit" asp-action="Index">
                            <i class="bi bi-diagram-3"></i>
                            <span>Sub Unit</span>
                        </a>
                        <a class="nav-link" asp-controller="Metode" asp-action="Index">
                            <i class="bi bi-wrench"></i>
                            <span>Metode</span>
                        </a>
                        <a class="nav-link" asp-controller="Standar" asp-action="Index">
                            <i class="bi bi-clipboard-check"></i>
                            <span>Standar</span>
                        </a>
                    </div>
                </div>

                <!-- ============ SCHEDULE ============ -->
                <div class="menu-group" data-group="schedule">
                    <button class="menu-group-header" onclick="toggleGroup('schedule')">
                        <i class="bi bi-calendar-event group-icon"></i>
                        <span class="group-label">Jadwal</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="PmSchedule" asp-action="InputPm">
                            <i class="bi bi-pencil-square"></i>
                            <span>Input PM</span>
                        </a>
                        <a class="nav-link" asp-controller="PmSchedule" asp-action="Index">
                            <i class="bi bi-calendar-week"></i>
                            <span>Jadwal PM</span>
                        </a>
                        <a class="nav-link" asp-controller="Export" asp-action="Schedule">
                            <i class="bi bi-download"></i>
                            <span>Export Schedule</span>
                        </a>
                    </div>
                </div>

                <!-- ============ IMPLEMENTATION ============ -->
                <div class="menu-group" data-group="implementation">
                    <button class="menu-group-header" onclick="toggleGroup('implementation')">
                        <i class="bi bi-tools group-icon"></i>
                        <span class="group-label">Pelaksanaan</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="PmUpdate" asp-action="ByPart">
                            <i class="bi bi-wrench-adjustable"></i>
                            <span>Update PM per Part</span>
                        </a>
                        <a class="nav-link" asp-controller="PmUpdate" asp-action="ByWeek">
                            <i class="bi bi-calendar3-week"></i>
                            <span>Update PM per Week</span>
                        </a>
                    </div>
                </div>

                <!-- ============ REPORT ============ -->
                <div class="menu-group" data-group="report">
                    <button class="menu-group-header" onclick="toggleGroup('report')">
                        <i class="bi bi-file-earmark-bar-graph group-icon"></i>
                        <span class="group-label">Laporan</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="Report" asp-action="PmSchedule">
                            <i class="bi bi-table"></i>
                            <span>Report PM Schedule</span>
                        </a>
                        <a class="nav-link" asp-controller="Report" asp-action="PmGraph">
                            <i class="bi bi-graph-up"></i>
                            <span>Report PM Graph</span>
                        </a>
                    </div>
                </div>

            </nav>

            <!-- FOOTER -->
            <div class="sidebar-footer">
                <i class="bi bi-info-circle"></i>
                <span class="brand-text">Versi 1.0 — Lokal</span>
            </div>
        </aside>

        <!-- ================================================
             MAIN
             ================================================ -->
        <main class="app-main">
            <header class="app-topbar">
                <h5 class="mb-0 text-secondary">
                    <i class="bi bi-folder2-open"></i>
                    @ViewData["Title"]
                </h5>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-dark border">
                        <i class="bi bi-person-circle"></i> system
                    </span>
                </div>
            </header>

            <div class="app-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <!-- ================================================
         SCRIPTS (CDN)
         ================================================ -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        // ============================================
        // TOGGLE GROUP (COLLAPSIBLE MENU)
        // ============================================
        function toggleGroup(groupName) {
            const group = document.querySelector(`.menu-group[data-group="${groupName}"]`);
            if (!group) return;

            const isOpen = group.classList.contains('open');

            // Tutup grup lain (accordion mode)
            document.querySelectorAll('.menu-group.open').forEach(g => {
                if (g !== group) g.classList.remove('open');
            });

            if (isOpen) {
                group.classList.remove('open');
                localStorage.removeItem('menuOpen');
            } else {
                group.classList.add('open');
                localStorage.setItem('menuOpen', groupName);
            }
        }

        // ============================================
        // AUTO-OPEN GROUP BERDASARKAN URL
        // ============================================
        function autoOpenByUrl() {
            const path = window.location.pathname.toLowerCase();

            const urlMap = {
                'masterdata': ['/asset', '/part', '/bom', '/plant', '/line', '/area',
               '/product', '/brand', '/mccategory', '/machinefunction',
               '/unit', '/subunit', '/metode', '/standar'],
                'schedule':       ['/pmschedule', '/export'],
                'implementation': ['/pmupdate'],
                'report':         ['/report']
            };

            for (const [groupName, prefixes] of Object.entries(urlMap)) {
                if (prefixes.some(p => path.startsWith(p))) {
                    const group = document.querySelector(`.menu-group[data-group="${groupName}"]`);
                    if (group) group.classList.add('open');
                    localStorage.setItem('menuOpen', groupName);
                    return;
                }
            }

            const lastOpen = localStorage.getItem('menuOpen');
            if (lastOpen) {
                const group = document.querySelector(`.menu-group[data-group="${lastOpen}"]`);
                if (group) group.classList.add('open');
            }
        }

        // ============================================
        // HIGHLIGHT ACTIVE LINK
        // ============================================
        function highlightActiveLink() {
            const path = window.location.pathname.toLowerCase();

            document.querySelectorAll('.sidebar-nav .nav-link').forEach(link => {
                link.classList.remove('active');
                const href = link.getAttribute('href');
                if (!href) return;

                const hrefLower = href.toLowerCase();
                if (hrefLower === '/' && path === '/') {
                    link.classList.add('active');
                } else if (hrefLower !== '/' && path.startsWith(hrefLower)) {
                    link.classList.add('active');
                }
            });
        }

        // ============================================
        // TOGGLE SIDEBAR COLLAPSE
        // ============================================
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            sidebar.classList.toggle('collapsed');
            localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
        }

        // ============================================
        // INIT
        // ============================================
        document.addEventListener('DOMContentLoaded', function () {
            if (localStorage.getItem('sidebarCollapsed') === 'true') {
                document.getElementById('sidebar').classList.add('collapsed');
            }

            autoOpenByUrl();
            highlightActiveLink();

            // DataTables auto-init
            if (typeof $ !== 'undefined' && $.fn.DataTable) {
                $('.datatable').DataTable({
                    language: {
                        search: "Cari:",
                        lengthMenu: "Tampilkan _MENU_ data",
                        info: "Menampilkan _START_ - _END_ dari _TOTAL_ data",
                        infoEmpty: "Tidak ada data",
                        zeroRecords: "Data tidak ditemukan",
                        paginate: {
                            first: "Awal",
                            last: "Akhir",
                            next: "Berikutnya",
                            previous: "Sebelumnya"
                        }
                    },
                    pageLength: 10,
                    order: []
                });
            }
        });
    </script>
</body>
</html>