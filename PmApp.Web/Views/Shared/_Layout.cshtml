<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PM System</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/1.13.8/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />
    <link href="~/css/app-ui.css" rel="stylesheet" />

    <style>
            html, body {
                height: 100%;
                margin: 0;
                font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            }

            .app-wrapper {
                display: flex;
                height: 100vh;
                overflow: hidden;
            }

            /* SIDEBAR */
            .app-sidebar {
                width: 250px;
                background-color: #1e293b;
                color: #e2e8f0;
                display: flex;
                flex-direction: column;
                flex-shrink: 0;
            }

                .app-sidebar .brand {
                    padding: 1rem;
                    font-size: 1.1rem;
                    font-weight: 700;
                    border-bottom: 1px solid #334155;
                    color: #fff;
                    display: flex;
                    align-items: center;
                    gap: 0.6rem;
                    flex-shrink: 0;
                }

                    .app-sidebar .brand i {
                        color: #60a5fa;
                    }

            /* SCROLLABLE NAV */
            .sidebar-nav {
                flex: 1;
                overflow-y: auto;
                overflow-x: hidden;
                padding: 0.5rem 0;
            }

                .sidebar-nav::-webkit-scrollbar {
                    width: 6px;
                }

                .sidebar-nav::-webkit-scrollbar-track {
                    background: #1e293b;
                }

                .sidebar-nav::-webkit-scrollbar-thumb {
                    background: #475569;
                    border-radius: 3px;
                }

            /* MENU GROUP */
            .menu-group {
                margin-bottom: 0.2rem;
            }

            .menu-group-header {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 0.7rem 1rem;
                color: #cbd5e1;
                font-size: 0.85rem;
                font-weight: 600;
                cursor: pointer;
                border: none;
                background: none;
                width: 100%;
                text-align: left;
                transition: background 0.15s, color 0.15s;
                white-space: nowrap;
            }

                .menu-group-header:hover {
                    background-color: #334155;
                    color: #fff;
                }

                .menu-group-header .group-icon {
                    font-size: 1rem;
                    min-width: 22px;
                    text-align: center;
                    margin-right: 0.6rem;
                }

                .menu-group-header .group-label {
                    flex: 1;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .menu-group-header .group-chevron {
                    font-size: 0.75rem;
                    transition: transform 0.25s;
                    color: #64748b;
                }

            .menu-group.open .menu-group-header .group-chevron {
                transform: rotate(90deg);
                color: #60a5fa;
            }

            .menu-group.open .menu-group-header {
                color: #fff;
            }

            /* Submenu */
            .menu-group-body {
                overflow: hidden;
                max-height: 0;
                transition: max-height 0.35s ease;
            }

            .menu-group.open .menu-group-body {
                max-height: 800px;
            }

            /* NAV LINK */
            .sidebar-nav .nav-link {
                color: #cbd5e1;
                padding: 0.6rem 1rem 0.6rem 2.75rem;
                display: flex;
                align-items: center;
                gap: 0.7rem;
                font-size: 0.875rem;
                white-space: nowrap;
                text-decoration: none;
                transition: background 0.15s, color 0.15s;
                position: relative;
                border-left: 3px solid transparent;
            }

                .sidebar-nav .nav-link i {
                    font-size: 0.95rem;
                    min-width: 20px;
                    text-align: center;
                    flex-shrink: 0;
                }

                .sidebar-nav .nav-link span {
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                .sidebar-nav .nav-link:hover {
                    background-color: #334155;
                    color: #fff;
                }

                .sidebar-nav .nav-link.active {
                    background-color: #1e40af;
                    color: #fff;
                    border-left-color: #60a5fa;
                    font-weight: 500;
                }

            /* FOOTER */
            .sidebar-footer {
                padding: 0.75rem 1rem;
                font-size: 0.75rem;
                color: #64748b;
                border-top: 1px solid #334155;
                flex-shrink: 0;
            }

            /* MAIN AREA */
            .app-main {
                flex: 1;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                min-width: 0;
            }

            .app-topbar {
                background-color: #fff;
                border-bottom: 1px solid #e2e8f0;
                padding: 0.85rem 1.5rem;
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 1rem;
                flex-shrink: 0;
            }

            .app-content {
                flex: 1;
                overflow-y: auto;
                padding: 1.5rem;
                background-color: #f1f5f9;
            }

            /* DELAY (orange) */
            .bg-delay {
                background-color: #fd7e14 !important;
                color: #fff;
            }

            .text-delay {
                color: #fd7e14 !important;
                font-weight: 600;
            }

        /* SIDEBAR COLLAPSE (desktop) */
        .app-sidebar {
            transition: width .25s ease;
            overflow: hidden;
        }
        .app-wrapper.sidebar-collapsed .app-sidebar {
            width: 0;
        }
        .sidebar-toggle {
            border: 1px solid #e2e8f0;
            background: white;
            color: #334155;
            width: 38px;
            height: 38px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: .5rem;
            flex-shrink: 0;
        }
        .sidebar-toggle:hover { background: #f1f5f9; }
        .sidebar-overlay { display: none; }

        /* Mobile: sidebar menjadi panel di atas konten */
        @@media (max-width: 767.98px) {
            .app-sidebar {
                position: fixed;
                top: 0;
                bottom: 0;
                left: 0;
                z-index: 1051;
                width: 250px !important;
                transform: translateX(-100%);
                transition: transform .25s ease;
            }
            .app-wrapper.mobile-sidebar-open .app-sidebar {
                transform: translateX(0);
            }
            .app-wrapper.mobile-sidebar-open .sidebar-overlay {
                display: block;
                position: fixed;
                inset: 0;
                background: rgba(15, 23, 42, .5);
                z-index: 1050;
            }
            .app-topbar { padding: .75rem; }
            .app-content { padding: 1rem; }
        }
    </style>
</head>
<body>
    <div class="app-wrapper" id="appWrapper">
        <div class="sidebar-overlay" id="sidebarOverlay" aria-hidden="true"></div>

        <!-- ================================================
             SIDEBAR
             ================================================ -->
        <aside class="app-sidebar" id="sidebar">

            <div class="brand">
                <i class="bi bi-gear-wide-connected"></i>
                <span>PM System</span>
            </div>

            <nav class="sidebar-nav">

                <!-- ============ DASHBOARD ============ -->
                <a class="nav-link" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-speedometer2"></i>
                    <span>Dashboard</span>
                </a>

                <!-- ============ MASTER DATA ============ -->
                <div class="menu-group" data-group="masterdata">
                    <button class="menu-group-header" onclick="toggleGroup('masterdata')">
                        <i class="bi bi-database group-icon"></i>
                        <span class="group-label">Data Master</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="Plant" asp-action="Index">
                            <i class="bi bi-building"></i><span>Plant</span>
                        </a>
                        <a class="nav-link" asp-controller="Line" asp-action="Index">
                            <i class="bi bi-diagram-2"></i><span>Line</span>
                        </a>
                        <a class="nav-link" asp-controller="Area" asp-action="Index">
                            <i class="bi bi-grid-3x3-gap"></i><span>Area</span>
                        </a>
                        <a class="nav-link" asp-controller="Product" asp-action="Index">
                            <i class="bi bi-box"></i><span>Product</span>
                        </a>
                        <a class="nav-link" asp-controller="Brand" asp-action="Index">
                            <i class="bi bi-award"></i><span>Brand</span>
                        </a>
                        <a class="nav-link" asp-controller="McCategory" asp-action="Index">
                            <i class="bi bi-cpu"></i><span>Kategori Mesin</span>
                        </a>
                        <a class="nav-link" asp-controller="MachineFunction" asp-action="Index">
                            <i class="bi bi-tools"></i><span>Fungsi Mesin</span>
                        </a>
                        <a class="nav-link" asp-controller="Unit" asp-action="Index">
                            <i class="bi bi-boxes"></i><span>Unit</span>
                        </a>
                        <a class="nav-link" asp-controller="SubUnit" asp-action="Index">
                            <i class="bi bi-box-seam"></i><span>Sub Unit</span>
                        </a>
                        <a class="nav-link" asp-controller="Metode" asp-action="Index">
                            <i class="bi bi-wrench"></i><span>Metode</span>
                        </a>
                        <a class="nav-link" asp-controller="Standar" asp-action="Index">
                            <i class="bi bi-rulers"></i><span>Standar</span>
                        </a>
                        <a class="nav-link" asp-controller="Asset" asp-action="Index">
                            <i class="bi bi-gear"></i><span>Mesin</span>
                        </a>
                        <a class="nav-link" asp-controller="Part" asp-action="Index">
                            <i class="bi bi-box-seam"></i><span>Part</span>
                        </a>
                        <a class="nav-link" asp-controller="Bom" asp-action="Index">
                            <i class="bi bi-diagram-3"></i><span>Pemasangan (BOM)</span>
                        </a>
                    </div>
                </div>

                <!-- ============ PM ============ -->
                <div class="menu-group" data-group="pm">
                    <button class="menu-group-header" onclick="toggleGroup('pm')">
                        <i class="bi bi-calendar-check group-icon"></i>
                        <span class="group-label">PM</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="PmTaskTemplate" asp-action="ListPm">
                            <i class="bi bi-list-ul"></i><span>Daftar Task PM</span>
                        </a>
                        <a class="nav-link" asp-controller="PmSchedule" asp-action="Index">
                            <i class="bi bi-calendar-week"></i><span>Jadwal PM</span>
                        </a>
                        <a class="nav-link" asp-controller="PmSchedule" asp-action="ByWeek">
                            <i class="bi bi-calendar3-week"></i><span>List Mingguan PM</span>
                        </a>
                        <a class="nav-link" asp-controller="PmSchedule" asp-action="ByMonth">
                            <i class="bi bi-calendar-month"></i><span>List Bulanan PM</span>
                        </a>
                    </div>
                </div>
                                <!-- ============ IMPORT ============ -->
                <div class="menu-group" data-group="import">
                    <button class="menu-group-header" onclick="toggleGroup('import')">
                        <i class="bi bi-file-earmark-excel group-icon"></i>
                        <span class="group-label">Import Data</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="Import" asp-action="Index">
                            <i class="bi bi-upload"></i>
                            <span>Import Excel</span>
                        </a>
                    </div>
                </div>
                <!-- ============ LAPORAN ============ -->
                <div class="menu-group" data-group="report">
                    <button class="menu-group-header" onclick="toggleGroup('report')">
                        <i class="bi bi-file-earmark-bar-graph group-icon"></i>
                        <span class="group-label">Laporan</span>
                        <i class="bi bi-chevron-right group-chevron"></i>
                    </button>
                    <div class="menu-group-body">
                        <a class="nav-link" asp-controller="Report" asp-action="PmSchedule">
                            <i class="bi bi-table"></i><span>Report PM Schedule</span>
                        </a>
                        <a class="nav-link" asp-controller="Report" asp-action="PmGraph">
                            <i class="bi bi-graph-up"></i><span>Report PM Graph</span>
                        </a>
                    </div>
                </div>

            </nav>

            <div class="sidebar-footer">
                <i class="bi bi-info-circle"></i> Versi 1.0 — Lokal
            </div>
        </aside>

        <!-- ================================================
             MAIN
             ================================================ -->
        <main class="app-main">
            <header class="app-topbar">
                <div class="d-flex align-items-center gap-2 min-w-0">
                    <button type="button" class="sidebar-toggle" id="sidebarToggle"
                            aria-label="Buka atau tutup sidebar" aria-controls="sidebar"
                            aria-expanded="true" title="Buka/tutup menu">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <h6 class="mb-0 text-secondary text-truncate">
                        <i class="bi bi-folder2-open d-none d-sm-inline"></i>
                        @ViewData["Title"]
                    </h6>
                </div>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="d-flex align-items-center gap-2">
                        <span class="badge bg-light text-dark border text-truncate" style="max-width: 180px;">
                            <i class="bi bi-person-circle"></i>
                            @(User.FindFirst("FullName")?.Value ?? User.Identity.Name)
                            <span class="d-none d-md-inline">(@(User.IsInRole("Admin") ? "Admin" : "Operator"))</span>
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Keluar dari akun">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-sm-inline">Logout</span>
                            </button>
                        </form>
                    </div>
                }
            </header>

            <div class="app-content">
                @RenderBody()
            </div>
        </main>
    </div>

    <script>
        // Sidebar: desktop collapse tersimpan, mobile memakai overlay.
        (function () {
            const wrapper = document.getElementById('appWrapper');
            const toggle = document.getElementById('sidebarToggle');
            const overlay = document.getElementById('sidebarOverlay');
            const mobile = window.matchMedia('(max-width: 767.98px)');

            function syncSidebar() {
                if (mobile.matches) {
                    wrapper.classList.remove('sidebar-collapsed');
                    toggle.setAttribute('aria-expanded',
                        String(wrapper.classList.contains('mobile-sidebar-open')));
                } else {
                    wrapper.classList.remove('mobile-sidebar-open');
                    const collapsed = localStorage.getItem('pm.sidebar.collapsed') === 'true';
                    wrapper.classList.toggle('sidebar-collapsed', collapsed);
                    toggle.setAttribute('aria-expanded', String(!collapsed));
                }
            }

            function closeMobileSidebar() {
                wrapper.classList.remove('mobile-sidebar-open');
                toggle.setAttribute('aria-expanded', 'false');
            }

            toggle.addEventListener('click', function () {
                if (mobile.matches) {
                    const open = wrapper.classList.toggle('mobile-sidebar-open');
                    toggle.setAttribute('aria-expanded', String(open));
                } else {
                    const collapsed = wrapper.classList.toggle('sidebar-collapsed');
                    localStorage.setItem('pm.sidebar.collapsed', String(collapsed));
                    toggle.setAttribute('aria-expanded', String(!collapsed));
                }
            });

            overlay.addEventListener('click', closeMobileSidebar);
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') closeMobileSidebar();
            });
            document.querySelectorAll('.sidebar-nav a').forEach(function (a) {
                a.addEventListener('click', function () {
                    if (mobile.matches) closeMobileSidebar();
                });
            });
            if (mobile.addEventListener) mobile.addEventListener('change', syncSidebar);
            else mobile.addListener(syncSidebar);
            syncSidebar();
        })();
    </script>
    <!-- CONFIRM MODAL + LOADING + TOAST -->
    <partial name="_ConfirmModal" />
    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/app-ui.js"></script>

    <script>
            document.addEventListener('DOMContentLoaded', function () {
                @if (TempData["Success"] != null)
                {
                        <text>showToast('success', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Success"]?.ToString())));</text>
                }
                @if (TempData["Error"] != null)
                {
                        <text>showToast('danger', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["Error"]?.ToString())));</text>
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
            // ============================================
            // TOGGLE GROUP
            // ============================================
            function toggleGroup(groupName) {
                var group = document.querySelector('.menu-group[data-group="' + groupName + '"]');
                if (!group) return;

                var isOpen = group.classList.contains('open');

                // Tutup grup lain
                document.querySelectorAll('.menu-group.open').forEach(function (g) {
                    if (g !== group) g.classList.remove('open');
                });

                if (isOpen) {
                    group.classList.remove('open');
                    localStorage.removeItem('menuOpen');
                } else {
                    group.classList.add('open');
                    localStorage.setItem('menuOpen', groupName);
                }
            }

            // ============================================
            // AUTO OPEN BY URL
            // ============================================
            function autoOpenByUrl() {
                var path = window.location.pathname.toLowerCase();

                var urlMap = {
                    'masterdata': ['/asset', '/part', '/bom', '/plant', '/line', '/area',
                                   '/product', '/brand', '/mccategory', '/machinefunction',
                                   '/unit', '/subunit', '/metode', '/standar'],
                    'pm':         ['/pmtasktemplate', '/pmschedule'],
                    'import':     ['/import'],
                    'report':     ['/report', '/export']
                };

                var opened = false;
                for (var groupName in urlMap) {
                    if (urlMap.hasOwnProperty(groupName)) {
                        var prefixes = urlMap[groupName];
                        for (var i = 0; i < prefixes.length; i++) {
                            if (path.indexOf(prefixes[i]) === 0) {
                                var group = document.querySelector('.menu-group[data-group="' + groupName + '"]');
                                if (group) {
                                    group.classList.add('open');
                                    localStorage.setItem('menuOpen', groupName);
                                    opened = true;
                                }
                                break;
                            }
                        }
                        if (opened) break;
                    }
                }

                if (!opened) {
                    var lastOpen = localStorage.getItem('menuOpen');
                    if (lastOpen) {
                        var group2 = document.querySelector('.menu-group[data-group="' + lastOpen + '"]');
                        if (group2) group2.classList.add('open');
                    }
                }
            }

            // ============================================
            // HIGHLIGHT ACTIVE LINK
            // ============================================
            function highlightActiveLink() {
                var path = window.location.pathname.toLowerCase();

                document.querySelectorAll('.sidebar-nav .nav-link').forEach(function (link) {
                    link.classList.remove('active');
                    var href = link.getAttribute('href');
                    if (!href) return;

                    var hrefLower = href.toLowerCase();
                    if (hrefLower === '/' && path === '/') {
                        link.classList.add('active');
                    } else if (hrefLower !== '/' && path.indexOf(hrefLower) === 0) {
                        link.classList.add('active');
                    }
                });
            }

            // ============================================
            // INIT
            // ============================================
            document.addEventListener('DOMContentLoaded', function () {
                autoOpenByUrl();
                highlightActiveLink();

                // Init DataTables
                if (typeof $ !== 'undefined' && $.fn.DataTable) {
                    $('.datatable').DataTable({
                        language: {
                            search: "Cari:",
                            lengthMenu: "Tampilkan _MENU_ data",
                            info: "Menampilkan _START_ - _END_ dari _TOTAL_ data",
                            infoEmpty: "Tidak ada data",
                            zeroRecords: "Data tidak ditemukan",
                            paginate: {
                                first: "Awal",
                                last: "Akhir",
                                next: "Berikutnya",
                                previous: "Sebelumnya"
                            }
                        },
                        pageLength: 10,
                        order: []
                    });
                }
            });
    </script>
</body>
</html>