@model PmApp.Web.Models.ViewModels.MetodeFormViewModel

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="mb-3">
    <label asp-for="Name" class="form-label fw-semibold"></label>
    <input asp-for="Name" class="form-control" placeholder="Contoh: Inspection" />
    <span asp-validation-for="Name" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Initial" class="form-label fw-semibold"></label>
    <input asp-for="Initial" class="form-control" placeholder="Contoh: INS (opsional)" />
    <span asp-validation-for="Initial" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="MachineState" class="form-label fw-semibold"></label>
    <select asp-for="MachineState" class="form-select"
            asp-items="Html.GetEnumSelectList<PmApp.Web.Models.MachineRunningState>()"></select>
    <span asp-validation-for="MachineState" class="text-danger small"></span>
</div>

<div class="mb-3">
    <label asp-for="Description" class="form-label fw-semibold"></label>
    <textarea asp-for="Description" class="form-control" rows="3"
              placeholder="Deskripsi metode (opsional)"></textarea>
    <span asp-validation-for="Description" class="text-danger small"></span>
</div>
