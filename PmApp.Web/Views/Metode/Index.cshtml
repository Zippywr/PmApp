@model IEnumerable<PmApp.Web.Models.Entities.Metode>
@{
    ViewData["Title"] = "Daftar Metode";
}

@if (TempData["Success"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            showNotify('success', '@Html.Raw(TempData["Success"]?.ToString()?.Replace("'", "\\'"))');
        });
    </script>
}
@if (TempData["Error"] != null)
{
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            showNotify('danger', '@Html.Raw(TempData["Error"]?.ToString()?.Replace("'", "\\'"))');
        });
    </script>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0"><i class="bi bi-wrench"></i> Daftar Metode</h4>
    <div class="d-flex gap-2">
        <a asp-controller="Import" asp-action="Metode" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel"></i> Import Excel
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Tambah Metode
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <table class="table table-hover mb-0 datatable">
            <thead class="table-light">
                <tr>
                    <th>Kode</th>
                    <th>Nama Metode</th>
                    <th>Initial</th>
                    <th>Machine State</th>
                    <th>Deskripsi</th>
                    <th width="180">Aksi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Code</strong></td>
                        <td>@item.Name</td>
                        <td><span class="badge bg-secondary">@item.Initial</span></td>
                        <td>
                            @if (item.MachineState == PmApp.Web.Models.MachineRunningState.ON)
                            {
                                <span class="badge bg-success">ON</span>
                            }
                            else if (item.MachineState == PmApp.Web.Models.MachineRunningState.OFF)
                            {
                                <span class="badge bg-danger">OFF</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">-</span>
                            }
                        </td>
                        <td>@item.Description</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-sm btn-warning" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <form asp-action="Delete" asp-route-id="@item.Id"
                                  method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="button"
                                        class="btn btn-sm btn-danger btn-delete"
                                        data-name="Metode '@item.Name'"
                                        data-detail="Kode: @item.Code">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>