@model PmApp.Web.Models.ViewModels.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login - MAINTENANCE";
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
          rel="stylesheet" />

    <style>
            :root {
                --primary: #1d4ed8;
                --primary-hover: #1e40af;
                --text: #0f172a;
                --muted: #475569;
                --border: #b9c8d9;
            }

            * {
                box-sizing: border-box;
            }

            body {
                margin: 0;
                min-height: 100vh;
                font-family: "Segoe UI", Arial, sans-serif;
                background: #f5f7fb;
                color: var(--text);
            }

            .login-page {
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 24px;
            }

            .login-card {
                width: 100%;
                max-width: 430px;
                padding: 44px 40px 38px;
                background: #ffffff;
                border: 1px solid #edf0f5;
                border-radius: 18px;
                box-shadow: 0 18px 55px rgba(15, 23, 42, 0.06), 0 2px 8px rgba(15, 23, 42, 0.025);
            }

            /* BRAND */

            .login-brand {
                display: flex;
                flex-direction: column;
                align-items: center;
                text-align: center;
                margin-bottom: 38px;
            }

            .brand-icon {
                width: 58px;
                height: 58px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #eff6ff;
                color: var(--primary);
                border-radius: 16px;
                margin-bottom: 17px;
            }

                .brand-icon i {
                    font-size: 29px;
                }

            .brand-title {
                margin: 0;
                font-size: 25px;
                font-weight: 750;
                letter-spacing: -0.7px;
                color: #172337;
            }

            /* FORM */

            .form-label {
                font-size: 13px;
                font-weight: 600;
                color: #475569;
                margin-bottom: 9px;
            }

            .input-wrapper {
                position: relative;
            }

            .input-icon {
                position: absolute;
                top: 50%;
                left: 16px;
                transform: translateY(-50%);
                color: #94a3b8;
                font-size: 17px;
                pointer-events: none;
            }

            .login-input {
                height: 52px;
                padding: 12px 16px 12px 46px;
                border: 1px solid var(--border);
                border-radius: 10px;
                font-size: 14px;
                background: #fff;
                transition: border-color .2s, box-shadow .2s;
            }

                .login-input::placeholder {
                    color: #a3afbf;
                }

                .login-input:focus {
                    border-color: var(--primary);
                    box-shadow: 0 0 0 3px rgba(37, 99, 235, .09);
                }

            .password-input {
                padding-right: 52px;
            }

            .password-toggle {
                position: absolute;
                top: 50%;
                right: 9px;
                transform: translateY(-50%);
                width: 36px;
                height: 36px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: transparent;
                border: none;
                border-radius: 8px;
                color: #94a3b8;
                cursor: pointer;
            }

                .password-toggle:hover {
                    color: var(--primary);
                    background: #eff6ff;
                }

            /* BUTTON */

            .btn-login {
                width: 100%;
                height: 51px;
                background: var(--primary);
                border: 1px solid var(--primary);
                border-radius: 10px;
                color: #fff;
                font-size: 14px;
                font-weight: 600;
                transition: background .2s, box-shadow .2s;
            }

                .btn-login:hover {
                    background: var(--primary-hover);
                    border-color: var(--primary-hover);
                    color: #fff;
                    box-shadow: 0 6px 15px rgba(37, 99, 235, .16);
                }

            /* VALIDATION */

            .field-validation-error {
                display: block;
                margin-top: 6px;
                color: #dc2626;
                font-size: 12px;
            }

            .validation-summary-errors {
                padding: 12px 14px;
                margin-bottom: 20px;
                background: #fef2f2;
                border: 1px solid #fecaca;
                border-radius: 9px;
                color: #b91c1c;
                font-size: 12px;
            }

                .validation-summary-errors ul {
                    margin: 0;
                    padding-left: 17px;
                }

            .validation-summary-valid {
                display: none;
            }

            @@media (max-width: 480px) {
                .login-page {
                    padding: 16px;
                }

                .login-card {
                    padding: 34px 25px;
                    border-radius: 15px;
                }
            }
    </style>
</head>

<body>

    <main class="login-page">

        <div class="login-card">

            <!-- BRAND -->

            <div class="login-brand">

                <div class="brand-icon">
                    <i class="bi bi-gear-wide-connected"></i>
                </div>

                <h1 class="brand-title">
                    MAINTENANCE
                </h1>
            </div>

            <!-- LOGIN FORM -->

            <form asp-controller="Account"
                  asp-action="Login"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="ReturnUrl" />

                <div asp-validation-summary="All"
                     class="validation-summary"
                     role="alert">
                </div>

                <!-- USERNAME -->

                <div class="mb-4">

                    <label asp-for="Username"
                           class="form-label">
                        Username
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-person input-icon"></i>

                        <input asp-for="Username"
                               class="form-control login-input"
                               placeholder="Username"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false" />

                    </div>

                    <span asp-validation-for="Username"
                          class="field-validation-error">
                    </span>

                </div>

                <!-- PASSWORD -->

                <div class="mb-4">

                    <label asp-for="Password"
                           class="form-label">
                        Password
                    </label>

                    <div class="input-wrapper">

                        <i class="bi bi-lock input-icon"></i>

                        <input asp-for="Password"
                               id="loginPassword"
                               type="password"
                               class="form-control login-input password-input"
                               placeholder="Password"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                id="togglePassword"
                                aria-label="Tampilkan password"
                                aria-pressed="false">

                            <i class="bi bi-eye"></i>

                        </button>

                    </div>

                    <span asp-validation-for="Password"
                          class="field-validation-error">
                    </span>

                </div>

                <!-- SUBMIT -->

                <button type="submit"
                        class="btn btn-login">

                    Masuk

                </button>

            </form>

        </div>

    </main>

    <script>
            document.addEventListener('DOMContentLoaded', function () {

                const input =
                    document.getElementById('loginPassword');

                const button =
                    document.getElementById('togglePassword');

                if (!input || !button) return;

                button.addEventListener('click', function () {

                    const show = input.type === 'password';

                    input.type = show ? 'text' : 'password';

                    button.innerHTML = show
                        ? '<i class="bi bi-eye-slash"></i>'
                        : '<i class="bi bi-eye"></i>';

                    button.setAttribute(
                        'aria-label',
                        show ? 'Sembunyikan password' : 'Tampilkan password'
                    );

                    button.setAttribute(
                        'aria-pressed',
                        String(show)
                    );

                });

            });
    </script>

</body>
</html>
